<UserControl x:Class="FMSFrontend.Views.ProductionLines" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:conv="clr-namespace:FMSFrontend.Converters" mc:Ignorable="d" d:DesignHeight="912" d:DesignWidth="1532" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        

        <Storyboard x:Key="ShakeRobotStoryboard">
            <DoubleAnimation Storyboard.TargetName="RobotTransform" Storyboard.TargetProperty="X" From="0" To="10" Duration="0:0:0.1" AutoReverse="True" RepeatBehavior="3x" />
        </Storyboard>

        <Storyboard x:Key="MoveBorderStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BorderTransform" Storyboard.TargetProperty="X" From="0" To="1120" Duration="0:0:5" />
        </Storyboard>
    </UserControl.Resources>

    <Border Background="{DynamicResource PageViewBrush}">
        <Grid Background="{DynamicResource PageViewBrush}" Margin="16,20,16,18">
            <!-- 40+724+90 = 854 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <!-- 上方：Title -->
                <RowDefinition Height="724" />
                <!-- 中間：主內容 -->
                <RowDefinition Height="*" />
                <!-- 下方：手臂狀態 -->
            </Grid.RowDefinitions>

            <!-- 上方：Icon + 標題 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <!-- MaterialDesign PackIcon -->
                <materialDesign:PackIcon Kind="Factory" Width="24" Height="24" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,3,0" />
                <TextBlock Text="產線總覽" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            
            <!-- ✅ 中間：內容容器 -->
            <Grid Grid.Row="1" Margin="0 10 0 0">
                <!-- 等一下這邊我們可以切左右欄位，或再塞 ItemsControl + WrapPanel -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="899" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Grid.Row="1" Margin="0,0,0,0" Background="White" Content="{Binding CurrentStorageView}" />
                <ContentControl Grid.Column="1" Grid.Row="1" Margin="10,0,0,0"  Background="White" Content="{Binding CurrentWorkingZoneView}" />

                
            </Grid>

            <!-- ✅ 下方：機械手臂狀態 -->
            <Grid Grid.Row="2" Background="Transparent" SnapsToDevicePixels="True" HorizontalAlignment="Left" Margin ="10,0,10,0">
                <Border x:Name="MovingBorder" CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="1" Background="#CCCCCC" Width="352" Height="102" Margin="0,10,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BorderTransform" />
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左側：機械手臂圖與狀態條 -->
                        <StackPanel x:Name="RobotPanel" Grid.Column="0" Margin="25,0,10,0" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="RobotTransform" />
                            </StackPanel.RenderTransform>

                            <Button Style="{StaticResource ImageButton}" Command="{Binding OpenRobotWindowCommand}" ToolTip="查看機器人資訊">
                                <Image Source="pack://application:,,,/FMSFrontend;component/Image/MachineIcons/Robot.png" Width="71" Height="79" Margin="0,3,0,0" />
                            </Button>

                            <!--<Image Source="pack://application:,,,/FMSFrontend;component/Image/MachineIcons/Robot.png" Width="71" Height="79" HorizontalAlignment="Center" Margin="0,3,0,0" MouseLeftButtonUp="RobotImage_MouseLeftButtonUp" ToolTip="查看機器人資訊" />-->
                            <!-- 狀態條 -->
                            <Border Name="RobotStatus" Height="12" Width="112" CornerRadius="6"
                                Background="{Binding DataContext.Robot.StatusBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Green}"
                                Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- 右側：顯示文字（可點擊開資訊視窗） -->
                        <Button Name="BtnMMaterial" Grid.Column="1" Height="40" Width="176" Padding="12,6" Command="{Binding ShowCurrentMaterialInfoCommand}" Cursor="Hand" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" Foreground="#555" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Button.Resources>
                                <!-- 讓 Button 的外框也吃圓角 -->
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5" />
                                </Style>
                            </Button.Resources>
                            <!-- 使用 TextBlock 顯示文字，避免 AccessText 吃掉底線 -->
                            <TextBlock Text="{Binding DataContext.Robot.MaterialShortName, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue=—, FallbackValue=—}"/>
                        </Button>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>