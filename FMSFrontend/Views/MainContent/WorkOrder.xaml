                                                                                                        <DataGridTextColumn Header="設定者" FontSize="18" Binding="{Binding SetupUser}" Width="110" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                    </DataGrid.Columns>
                                                                                                </DataGrid>
                                                                                            </Border>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>

                                                                    <!-- Completed (index 3) -->
                                                                    <DataTrigger Binding="{Binding EDMSelectedTab}" Value="3">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <Border CornerRadius="10" BorderBrush="#CCC" BorderThickness="1" Padding="15" Background="White">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="50" />
                                                                                                <RowDefinition Height="*" />
                                                                                            </Grid.RowDefinitions>

                                                                                            <!-- 上方日期篩選器 -->
                                                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                                                                                <ComboBox Width="120" Height="32" Margin="10,0,0,0" ItemsSource="{Binding DateFilterOptions}" SelectedItem="{Binding SelectedFilterOption}" Style="{StaticResource PillComboBoxStyle}" />
                                                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomDateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                                    <DatePicker Width="180" Height="32" Margin="8,0,0,0" SelectedDate="{Binding FromDate}"  IsEnabled="{Binding IsCustomDateMode}" Style="{StaticResource CustomDatePickerStyle}" />
                                                                                                    <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" VerticalAlignment="Center" Margin="6,0,6,0" />
