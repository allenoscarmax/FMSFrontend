                                                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                                                <DataTemplate>
                                                                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,6,0" />
                                                                                                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="18" />
                                                                                                                    </StackPanel>
                                                                                                                </DataTemplate>
                                                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                                                        </DataGridTemplateColumn>

                                                                                                        <DataGridTextColumn Header="目標EDM" FontSize="18" Binding="{Binding TargetEDM}" Width="100" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                        <DataGridTextColumn Header="座標" FontSize="18" Binding="{Binding Coordinate}" Width="100" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                        <DataGridTextColumn Header="設定者" FontSize="18" Binding="{Binding SetupUser}" Width="110" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                    </DataGrid.Columns>
                                                                                                </DataGrid>

                                                                                            </Border>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>

                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>

                                                </Grid>
                                            </DataTemplate>

                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                
                                <!-- ✅ Tab 2：Failure -->
                                <DataTrigger Binding="{Binding SelectedTabIndexParameter}" Value="2">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Grid>
                                                    <!-- 外框 -->
                                                    <Border Grid.Row="1" CornerRadius="0" BorderBrush="#CCC" BorderThickness="1" Background="White" SnapsToDevicePixels="True" Margin="0,0,0,8">
                                                        <DataGrid ItemsSource="{Binding FailureWorkOrders}" SelectedItem="{Binding SelectedEDMQueueItem}" behaviors:RowDetailsToggleBehavior.KeepSelection="False" behaviors:RowDetailsToggleBehavior.ToggleOnRowClick="True"  SelectionMode="Single" SelectionUnit="FullRow" Style="{StaticResource EDMWorkOrderGridStyle}" RowDetailsTemplate="{StaticResource EDMRowDetailsTemplate}">
                                                            <DataGrid.Columns>
                                                                <!-- 第 0 欄：展開箭頭 -->
                                                                <DataGridTemplateColumn Width="40">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <materialDesign:PackIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <materialDesign:PackIcon.Style>
