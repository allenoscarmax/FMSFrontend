<UserControl x:Class="FMSFrontend.Views.WorkOrder" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:FMSFrontend.Converters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:selectors="clr-namespace:FMSFrontend.Selectors" xmlns:behaviors="clr-namespace:FMSFrontend.Extensions"
             mc:Ignorable="d" d:DesignHeight="912" d:DesignWidth="1532">

    <UserControl.Resources>
        <selectors:TabItemBackgroundSelector x:Key="TabItemColorSelector" />
        <local:BoolToIconConverter x:Key="BoolToIconConverter" />
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="8" ShadowDepth="2" Color="Black" Opacity="0.25" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="EDMWorkOrderGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernFlatDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed" />

            <Setter Property="ColumnHeaderStyle" Value="{StaticResource CompactDataGridColumnHeaderStyle}" />

            <!-- RowDetails toggle behavior：只點第 0 欄展開，其他欄負責選取 -->
            <Setter Property="behaviors:RowDetailsToggleBehavior.IsEnabled" Value="True" />
            <Setter Property="behaviors:RowDetailsToggleBehavior.ToggleOnRowClick" Value="False" />
            <Setter Property="behaviors:RowDetailsToggleBehavior.ExpandColumnIndex" Value="0" />
            <!--<Setter Property="behaviors:RowDetailsToggleBehavior.KeepSelection" Value="True" />-->

            <!-- 你目前的「跨表格互斥選取」 -->
            <Setter Property="behaviors:ExclusiveSelectionBehavior.IsEnabled" Value="True" />
            <Setter Property="behaviors:ExclusiveSelectionBehavior.Group" Value="EDMSelection" />

            <!-- RowStyle：DetailsVisibility 綁 IsExpanded -->
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="DetailsVisibility">
                            <Setter.Value>
                                <Binding Path="IsExpanded" Converter="{StaticResource BooleanToVisibilityConverter}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EDMRowDetailsTemplate">
            <StackPanel DataContext="{Binding Item, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Margin="0,2,0,2" Background="#DDDDDD">

                <StackPanel Orientation="Horizontal" Margin="0,20,0,20" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EDMStageDisplay}" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="50,0,8,0" />
                    <ProgressBar Value="{Binding EDMStageProgress, Mode=OneWay}" Height="8" Width="200" />
                </StackPanel>

                <DataGrid IsReadOnly="True" ItemsSource="{Binding EDMDetails}" Margin="40,0,40,20" Style="{StaticResource ModernFlatDataGridStyle}" AutoGenerateColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" FontSize="14" >
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeaderStyle}">
                            <Setter Property="FontWeight" Value="Normal" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="Black" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="電極名稱" Binding="{Binding ElectrodeName}" Width="250" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                        <DataGridTextColumn Header="標籤序號" Binding="{Binding LabelSerial}" Width="200" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                        <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="80" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                        <DataGridTextColumn Header="加工程式" Binding="{Binding EDMProgram}" Width="300" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                        <DataGridTextColumn Header="補償" Binding="{Binding Offset}" Width="80" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                        <DataGridTextColumn Header="是否共用電極" Binding="{Binding IsShare}" Width="130" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                        <DataGridTextColumn Header="共用電極名稱" Binding="{Binding ShareElectrode}" Width="250" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Border Background="{DynamicResource PageViewBrush}">
        <Grid Margin="16,20,16,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <!-- 標題列 -->
                <RowDefinition Height="50" />
                <!-- Tabs -->
                <RowDefinition Height="*" />
                <!-- 內容區（根據所選 Tab 切換） -->
            </Grid.RowDefinitions>

            <!-- 標題列 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ClipboardListOutline" VerticalAlignment="Center" Width="24" Height="24" Margin="0,0,4,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="工單管理" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Tabs -->
            <TabControl Grid.Row="1" Tag="MainTab" SelectedIndex="{Binding SelectedTabIndexParameter}" Style="{StaticResource FlatTabControlStyle}" Height="40" Margin="0,8,0,0" Background="Transparent" ItemContainerStyleSelector="{StaticResource TabItemColorSelector}">
                <TabItem Header="新工單" Tag="#2779A7" />
                <TabItem Header="EDM" Tag="#2779A7" />
                <TabItem Header="失敗工單" Tag="#2779A7" />
            </TabControl>

            <!-- 外部已經統一套好卡片框 -->
            <Border Background="White" CornerRadius="0,0,10,10" Padding="40,16,40,24" Effect="{StaticResource ShadowEffect}" Grid.Row="2">

                <!-- 切換內容區 -->
                <ContentControl Grid.Row="2" Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>

                                <!-- ✅ Tab 0：New -->
                                <DataTrigger Binding="{Binding SelectedTabIndexParameter}" Value="0">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Upload 按鈕 -->
                                                        <Button Command="{Binding OpenUploadSheetCommand}" Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,16" Background="#0070E0" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Effect="{StaticResource ShadowEffect}" Style="{StaticResource  PrimaryButtonStyle}" Width="180" Height="40">
                                                            <Border CornerRadius="8" Background="Transparent">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="Upload" Width="20" Height="20" Margin="0,0,6,0" />
                                                                    <TextBlock Text="上傳工單" FontSize="18" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Button>

                                                        <!-- 外框 -->
                                                        <Border Grid.Row="1" CornerRadius="0" BorderBrush="#CCC" BorderThickness="1" Background="White" SnapsToDevicePixels="True" Margin="0,0,0,8">
                                                            <Grid>
                                                                <DataGrid Name="NewWorkDataGrid" behaviors:RowDetailsToggleBehavior.IsEnabled="True" behaviors:RowDetailsToggleBehavior.KeepSelection="False" behaviors:RowDetailsToggleBehavior.ToggleOnRowClick="True" behaviors:ExclusiveSelectionBehavior.Group="WorkOrderSelection" SelectionMode="Single" SelectionUnit="FullRow" ItemsSource="{Binding WorkOrderList}" ColumnHeaderStyle="{StaticResource CompactDataGridColumnHeaderStyle}" IsReadOnly="True" AutoGenerateColumns="False" RowDetailsVisibilityMode="Collapsed" CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False" RowHeight="44">
                                                                    <DataGrid.Style>
                                                                        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernFlatDataGridStyle}" />
                                                                    </DataGrid.Style>
                                                                    <!-- ✅ RowStyle 控制展開 -->
                                                                    <DataGrid.RowStyle>
                                                                        <Style TargetType="DataGridRow">
                                                                            <Setter Property="DetailsVisibility">
                                                                                <Setter.Value>
                                                                                    <Binding Path="IsExpanded" Converter="{StaticResource BooleanToVisibilityConverter}" />
                                                                                </Setter.Value>

                                                                            </Setter>
                                                                            <Setter Property="FontSize" Value="20" />

                                                                        </Style>
                                                                    </DataGrid.RowStyle>
                                                                    <!-- ✅ Columns 開始 -->
                                                                    <DataGrid.Columns>
                                                                        <DataGridTemplateColumn Width="40">
                                                                            <DataGridTemplateColumn.CellStyle>
                                                                                <Style TargetType="DataGridCell">
                                                                                    <Setter Property="Tag" Value="ExpandClickArea" />
                                                                                </Style>
                                                                            </DataGridTemplateColumn.CellStyle>
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Tag="ExpandClickArea">
                                                                                        <!-- ← Tag 是關鍵 -->
                                                                                        <materialDesign:PackIcon Width="20" Height="20">
                                                                                            <materialDesign:PackIcon.Style>
                                                                                                <Style TargetType="materialDesign:PackIcon">
                                                                                                    <Setter Property="Kind" Value="ChevronRight" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                                            <Setter Property="Kind" Value="ChevronDown" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </materialDesign:PackIcon.Style>
                                                                                        </materialDesign:PackIcon>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>

                                                                        <DataGridTextColumn Header="工單編號" FontSize="18" Binding="{Binding WorksheetNumber}" Width="220" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                        <DataGridTextColumn Header="工件名稱" FontSize="18" Binding="{Binding WorkpieceName}" Width="300" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                        <DataGridTemplateColumn Header="狀態" Width="180">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                                        <TextBlock Text="{Binding Status}" FontSize="18" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>

                                                                        <DataGridTextColumn Header="目標EDM" FontSize="18" Binding="{Binding TargetEDM}" Width="100" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                        <DataGridTextColumn Header="座標" FontSize="18" Binding="{Binding Coordinate}" Width="100" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                        <DataGridTextColumn Header="設定者" FontSize="18" Binding="{Binding SetupUser}" Width="110" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                        <DataGridTemplateColumn Header="刪除" Width="60">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" ToolTip="刪除">
                                                                                        <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="#0070E0" Width="20" Height="20" />
                                                                                    </Button>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>
                                                                    </DataGrid.Columns>

                                                                    <DataGrid.RowDetailsTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Margin="0,2,0,2" Background="#DDDDDD">
                                                                                <StackPanel DataContext="{Binding Item, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Orientation="Horizontal" Margin="0,20,0,10" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding EDMStageDisplay}" FontSize="18" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="50,0,8,0" />
                                                                                    <ProgressBar Value="{Binding EDMStageProgress, Mode=OneWay}" Height="8" Width="200" VerticalAlignment="Center" />
                                                                                </StackPanel>

                                                                                <DataGrid IsReadOnly="True" Margin="40,0,40,20" ItemsSource="{Binding EDMDetails}" Style="{StaticResource ModernFlatDataGridStyle}" AutoGenerateColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" FontSize="14" >
                                                                                    <DataGrid.ColumnHeaderStyle>
                                                                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeaderStyle}">
                                                                                            <Setter Property="FontWeight" Value="Normal" />
                                                                                        </Style>
                                                                                    </DataGrid.ColumnHeaderStyle>
                                                                                    <DataGrid.RowStyle>
                                                                                        <Style TargetType="DataGridRow">
                                                                                            <Setter Property="MinHeight" Value="40" />
                                                                                            <Setter Property="Padding" Value="2" />
                                                                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                                                            <Setter Property="BorderThickness" Value="1" />
                                                                                            <Setter Property="BorderBrush" Value="Black" />
                                                                                        </Style>
                                                                                    </DataGrid.RowStyle>

                                                                                    <DataGrid.Columns>
                                                                                        <DataGridTextColumn Header="電極名稱" Binding="{Binding ElectrodeName}" Width="250" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                                                                        <DataGridTextColumn Header="標籤序號" Binding="{Binding LabelSerial}" Width="200" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                                                                        <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="80" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                                                                        <!-- ✅ Read-only, non-interactive checkbox -->
                                                                                        <DataGridCheckBoxColumn Header="需EDM" Binding="{Binding NeedEDM, Mode=OneWay}" Width="110" IsReadOnly="True">
                                                                                            <DataGridCheckBoxColumn.ElementStyle>
                                                                                                <Style TargetType="CheckBox" BasedOn="{StaticResource CenterAlignedCheckBoxStyle}">
                                                                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                                                                    <Setter Property="Focusable" Value="False" />
                                                                                                </Style>
                                                                                            </DataGridCheckBoxColumn.ElementStyle>
                                                                                        </DataGridCheckBoxColumn>
                                                                                        <DataGridTextColumn Header="加工程式" Binding="{Binding EDMProgram}" Width="Auto" MinWidth="150" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                                                                        <DataGridTextColumn Header="補償" Binding="{Binding Offset}" Width="80" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                                                                        <DataGridTextColumn Header="是否共用電極" Binding="{Binding IsShare}" Width="130" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                                                                        <DataGridTextColumn Header="共用電極名稱" Binding="{Binding ShareElectrode}" Width="250" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                                                                    </DataGrid.Columns>
                                                                                </DataGrid>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </DataGrid.RowDetailsTemplate>
                                                                </DataGrid>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </ScrollViewer>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- ✅ Tab 1：EDM -->
                                <DataTrigger Binding="{Binding SelectedTabIndexParameter}" Value="1">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- EDM 子頁籤 -->
                                                    <TabControl Grid.Row="0" Tag="SubTab" SelectedIndex="{Binding EDMSelectedTab}" Style="{StaticResource FlatTabControlStyle}" ItemContainerStyleSelector="{StaticResource TabItemColorSelector}" Height="40" Margin="0,0,0,8" Background="Transparent">
                                                        <TabItem Header="Waiting" Tag="#2779A7" />
                                                        <TabItem Header="Queueing" Tag="#2779A7" />
                                                        <TabItem Header="Processing" Tag="#2779A7" />
                                                        <TabItem Header="Completed" Tag="#2779A7" />
                                                    </TabControl>

                                                    <!-- 對應 EDMSelectedTab 顯示不同內容 -->
                                                    <ContentControl Grid.Row="1" Content="{Binding}">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Style.Triggers>

                                                                    <!-- Waiting -->
                                                                    <DataTrigger Binding="{Binding EDMSelectedTab}" Value="0">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <Border CornerRadius="10" BorderBrush="#CCC" BorderThickness="1" Padding="15" Background="White">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="50" />
                                                                                                <RowDefinition Height="*" />
                                                                                            </Grid.RowDefinitions>

                                                                                            <!-- 上方按鈕區 -->
                                                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                                                                                <!--<Button Content="Action" Width="80" Height="36" Background="#0070E0" Foreground="White" />
                                                                                                <Button Content="Action" Width="80" Height="36" Background="#0070E0" Foreground="White" Margin="12,0,0,0" />-->
                                                                                            </StackPanel>

                                                                                            <!-- 表格 -->
                                                                                            <Border Grid.Row="1" CornerRadius="0" BorderBrush="#CCC" BorderThickness="1" Background="White" SnapsToDevicePixels="True">
                                                                                                <DataGrid ItemsSource="{Binding FilteredEDMList}" SelectedItem="{Binding SelectedEDMQueueItem}"  behaviors:RowDetailsToggleBehavior.KeepSelection="False" behaviors:RowDetailsToggleBehavior.ToggleOnRowClick="True"  SelectionMode="Single" SelectionUnit="FullRow" Style="{StaticResource EDMWorkOrderGridStyle}" RowDetailsTemplate="{StaticResource EDMRowDetailsTemplate}">
                                                                                                    <DataGrid.Columns>
                                                                                                        <!-- 第 0 欄：展開箭頭 -->
                                                                                                        <DataGridTemplateColumn Width="40">
                                                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                                                <DataTemplate>
                                                                                                                    <materialDesign:PackIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                                        <materialDesign:PackIcon.Style>
                                                                                                                            <Style TargetType="materialDesign:PackIcon">
                                                                                                                                <Setter Property="Kind" Value="ChevronRight" />
                                                                                                                                <Style.Triggers>
                                                                                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                                                                        <Setter Property="Kind" Value="ChevronDown" />
                                                                                                                                    </DataTrigger>
                                                                                                                                </Style.Triggers>
                                                                                                                            </Style>
                                                                                                                        </materialDesign:PackIcon.Style>
                                                                                                                    </materialDesign:PackIcon>
                                                                                                                </DataTemplate>
                                                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                                                        </DataGridTemplateColumn>

                                                                                                        <DataGridTextColumn Header="工單編號" FontSize="18" Binding="{Binding WorksheetNumber}" Width="220" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                        <DataGridTextColumn Header="工件名稱" FontSize="18" Binding="{Binding WorkpieceName}" Width="300" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                        <DataGridTemplateColumn Header="狀態" Width="180">
                                                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                                                <DataTemplate>
                                                                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,6,0" />
                                                                                                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="18" />
                                                                                                                    </StackPanel>
                                                                                                                </DataTemplate>
                                                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                                                        </DataGridTemplateColumn>

                                                                                                        <DataGridTextColumn Header="目標EDM" FontSize="18" Binding="{Binding TargetEDM}" Width="100" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                        <DataGridTextColumn Header="座標" FontSize="18" Binding="{Binding Coordinate}" Width="100" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                        <DataGridTextColumn Header="設定者" FontSize="18" Binding="{Binding SetupUser}" Width="110" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                    </DataGrid.Columns>
                                                                                                </DataGrid>

                                                                                            </Border>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                    <!-- Queueing -->
                                                                    <DataTrigger Binding="{Binding EDMSelectedTab}" Value="1">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <Border CornerRadius="10" BorderBrush="#CCC" BorderThickness="1" Padding="15" Background="White">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="50" />
                                                                                                <RowDefinition Height="*" />
                                                                                            </Grid.RowDefinitions>

                                                                                            <!-- 上方按鈕區 -->
                                                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" />

                                                                                            <!-- 表格 -->
                                                                                            <Border Grid.Row="1" CornerRadius="0" BorderBrush="#CCC" BorderThickness="1" Background="White" SnapsToDevicePixels="True">
                                                                                                <DataGrid ItemsSource="{Binding FilteredEDMList}" SelectedItem="{Binding SelectedEDMQueueItem}" behaviors:RowDetailsToggleBehavior.KeepSelection="False" behaviors:RowDetailsToggleBehavior.ToggleOnRowClick="True" SelectionMode="Single" SelectionUnit="FullRow" Style="{StaticResource EDMWorkOrderGridStyle}" RowDetailsTemplate="{StaticResource EDMRowDetailsTemplate}">
                                                                                                    <DataGrid.Columns>
                                                                                                        <!-- 第 0 欄：展開箭頭 -->
                                                                                                        <DataGridTemplateColumn Width="40">
                                                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                                                <DataTemplate>
                                                                                                                    <materialDesign:PackIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                                        <materialDesign:PackIcon.Style>
                                                                                                                            <Style TargetType="materialDesign:PackIcon">
                                                                                                                                <Setter Property="Kind" Value="ChevronRight" />
                                                                                                                                <Style.Triggers>
                                                                                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                                                                        <Setter Property="Kind" Value="ChevronDown" />
                                                                                                                                    </DataTrigger>
                                                                                                                                </Style.Triggers>
                                                                                                                            </Style>
                                                                                                                        </materialDesign:PackIcon.Style>
                                                                                                                    </materialDesign:PackIcon>
                                                                                                                </DataTemplate>
                                                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                                                        </DataGridTemplateColumn>

                                                                                                        <DataGridTextColumn Header="工單編號" FontSize="18" Binding="{Binding WorksheetNumber}" Width="220" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                        <DataGridTextColumn Header="工件名稱" FontSize="18" Binding="{Binding WorkpieceName}" Width="300" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                        <DataGridTemplateColumn Header="狀態" Width="180">
                                                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                                                <DataTemplate>
                                                                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,6,0" />
                                                                                                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="18" />
                                                                                                                    </StackPanel>
                                                                                                                </DataTemplate>
                                                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                                                        </DataGridTemplateColumn>

                                                                                                        <DataGridTextColumn Header="目標EDM" FontSize="18" Binding="{Binding TargetEDM}" Width="100" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

                                                                                                        <DataGridTextColumn Header="座標" FontSize="18" Binding="{Binding Coordinate}" Width="100" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />

