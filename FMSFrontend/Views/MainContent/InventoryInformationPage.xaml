<UserControl x:Class="FMSFrontend.Views.InventoryInformationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:selectors="clr-namespace:FMSFrontend.Selectors" xmlns:conv="clr-namespace:FMSFrontend.Converters"
             mc:Ignorable="d" d:DesignHeight="912" d:DesignWidth="1532">

    <!-- 與 MachineOverviewPage 一致：TabItem 背景選擇器 -->
    <UserControl.Resources>
        <selectors:TabItemBackgroundSelector x:Key="TabItemColorSelector" />
        <conv:KeyDownEnterOnlyConverter x:Key="KeyDownEnterOnlyConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource PageViewBrush}">
        <!-- 與 MachineOverviewPage 相同的外層 Grid 切版 -->
        <Grid Background="{DynamicResource PageViewBrush}" Margin="16,20,16,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1129*" />
                <ColumnDefinition Width="371*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <!-- Title -->
                <RowDefinition Height="*" />
                <!-- 內容：Tab + 工具列 + 表格 -->
            </Grid.RowDefinitions>

            <!-- Title 區塊（同風格） -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Grid.ColumnSpan="2">
                <materialDesign:PackIcon Kind="Storage" Width="24" Height="24" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,4,0" />
                <TextBlock Text="倉儲庫存" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
            </StackPanel>

            <!-- 內容區：依 MachineOverviewPage 的三段式思路，改為 Tab +（可選工具列）+ 主表格 -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- TabControl -->
                    <RowDefinition Height="Auto" />
                    <!-- 工具列（搜尋／刷新） -->
                    <RowDefinition Height="*" />
                    <!-- 主內容：表格 -->
                </Grid.RowDefinitions>

                <!-- 輕入場動畫（與 MachineOverviewPage 一致） -->
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <!-- TabControl：沿用 FlatTabControlStyle + TabItemColorSelector 的設計方法 -->
                <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" Style="{StaticResource FlatTabControlStyle}" ItemContainerStyleSelector="{StaticResource TabItemColorSelector}" Height="40" Padding="0" Margin="0,8,0,0" Background="Transparent">
                    <TabItem Header="架上工件" Tag="#2779A7" />
                    <TabItem Header="架上電極" Tag="#2779A7" />
                    <!--    
                    <TabItem Header="已下架工件" Tag="#2779A7" />
                    <TabItem Header="已下架電極" Tag="#2779A7" />
                    -->
                </TabControl>

                <!-- 工具列（可選）：搜索 + 重新整理；若不需要可整段刪除 -->
                <Grid Grid.Row="1" Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 搜尋框：左側 icon + 下底線 TextBox（Enter 才觸發搜尋） -->
                    <Grid Height="40" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 放大鏡圖示 -->
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0" />

                        <!-- 下底線輸入框（依參考寫法） -->
                        <Border Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="#222" VerticalAlignment="Center" Width="300" HorizontalAlignment="Left">
                            <TextBox BorderThickness="0" Padding="4,4,4,6" FontSize="16" Foreground="#888" Background="Transparent" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="搜尋">
                                <!-- 按 Enter 才呼叫 SearchCommand -->
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="KeyDown">
                                        <i:InvokeCommandAction Command="{Binding SearchCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" EventArgsConverter="{StaticResource KeyDownEnterOnlyConverter}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </Border>
                    </Grid>

                    <Button Grid.Column="1" Content="重新整理" Margin="12,0,0,0" Width="120" Height="40" Command="{Binding RefreshCommand}" Foreground="White" Background="#1976D2" BorderBrush="#E5E7EB" BorderThickness="1" Cursor="Hand" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>

                <!-- 主內容：表格（完全依你提供的樣式與寫法） -->
                <Border Grid.Row="2" CornerRadius="0" BorderBrush="#CCC" BorderThickness="1" Background="White" SnapsToDevicePixels="True" Margin="0,0,0,0">
                    <DataGrid  ColumnWidth="SizeToCells" ItemsSource="{Binding InventoryList}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="36" ColumnHeaderHeight="40" FontSize="16" Style="{StaticResource ModernFlatDataGridStyle}" ColumnHeaderStyle="{StaticResource CompactDataGridColumnHeaderStyle}" GridLinesVisibility="None" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" SnapsToDevicePixels="True">

                        <!-- Cell / Row Style：移除邊框與多餘間距 -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="6,0,6,0" />
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- 依畫面欄位命名替換你的 Binding -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="倉位編號" Binding="{Binding SlotCode}"  Width="120" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                            <DataGridTextColumn Header="狀態" Binding="{Binding Status}"        Width="120" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                            <DataGridTextColumn Header="名稱" Binding="{Binding Name}"          Width="Auto" MinWidth="250" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                            <DataGridTextColumn Header="標籤序號" Binding="{Binding TagSerial}"     Width="Auto" MinWidth="250" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                            <DataGridTextColumn Header="目前位置" Binding="{Binding Location}"  Width="Auto" MinWidth="250" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                            <DataGridTextColumn Header="工單編號" Binding="{Binding Worksheet}" Width="170" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                            <DataGridTextColumn Header="加工程式" Binding="{Binding Program}"   Width="*" MinWidth="250" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
