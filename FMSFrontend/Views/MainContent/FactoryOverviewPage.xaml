<UserControl x:Class="FMSFrontend.Views.FactoryOverviewPage" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignHeight="912" d:DesignWidth="1532">

    <UserControl.Resources>
        <!-- 共用：白底卡片外觀（與產線總覽一致風格） -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PageViewBrush}">
        <Grid Background="{DynamicResource PageViewBrush}" Margin="16,20,16,18">
            <!-- 版面切割：上標題列 + 下左右兩欄 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <!-- 上：標題列 -->
                <RowDefinition Height="*" />
                <!-- 下：主內容（左右分欄） -->
            </Grid.RowDefinitions>

            <!-- 標題列（僅保留文字，之後可自行加圖示） -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <!-- MaterialDesign PackIcon -->
                <materialDesign:PackIcon Kind="LanConnect" Width="24" Height="24" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0" />
                <TextBlock Text="整場總覽" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            

            <!-- 下方左右分欄 -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="980" />
                    <!-- 左：產線配置 -->
                    <ColumnDefinition Width="20" />
                    <!-- 中：間距 -->
                    <ColumnDefinition Width="*" />
                    <!-- 右：任務工作條 -->
                </Grid.ColumnDefinitions>

                <!-- 左：產線配置卡片（內容先空） -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <!-- 之後把你的內容塞到這個 ContentControl -->
                    <ContentControl x:Name="FactoryLayoutHost" Content="{Binding FactoryLayoutContent}" />
                </Border>

                <!-- 右：任務工作條卡片（內容先空） -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <!-- 之後把你的清單或面板塞到這個 ContentControl -->
                    <ContentControl x:Name="TaskListHost" Content="{Binding TaskListContent}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
