<UserControl x:Class="FMSFrontend.Views.RFIDBind" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignHeight="912" d:DesignWidth="1532">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="8" ShadowDepth="2" Color="Black" Opacity="0.25" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource PageViewBrush}">
        <Grid Background="{DynamicResource PageViewBrush}" Margin="16,20,16,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1279*" />
                <ColumnDefinition Width="221*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <!-- 主標題 -->
                <RowDefinition Height="Auto" />
                <!-- 上方按鈕列 -->
                <RowDefinition Height="*" />
                <!-- 主內容 Content -->
            </Grid.RowDefinitions>

            <!-- 🔠 主標題 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <materialDesign:PackIcon Kind="QrCodeScan" VerticalAlignment="Center" Width="24" Height="24" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="RFID 燒錄" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 🔘 按鈕列 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,10">
                <Button Width="240" Height="78" Background="#0B65CC" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,30,0" Effect="{StaticResource ShadowEffect}" Command="{Binding OpenMaterialTypeSelectCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <!-- Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0055C7" />
                                </Trigger>

                                <!-- Pressed -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#003F9E" />
                                </Trigger>

                                <!-- Disabled -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#CCC" />
                                    <Setter Property="Foreground" Value="#888" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <!-- 內容區 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DatabaseImport" Width="36" Height="36" Margin="0,0,10,0" />
                        <TextBlock Text="物料燒錄" VerticalAlignment="Center" FontSize="24" />
                    </StackPanel>
                </Button>

                <Button Width="240" Height="78" Background="#0066D9" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Effect="{StaticResource ShadowEffect}" Command="{Binding ReadMaterialInformationCommand}" >
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <!-- Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0055C7" />
                                </Trigger>

                                <!-- Pressed -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#003F9E" />
                                </Trigger>

                                <!-- Disabled -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#CCC" />
                                    <Setter Property="Foreground" Value="#888" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <!-- 內容 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="BarcodeScan" Width="36" Height="36" Margin="0,0,10,0" />
                        <TextBlock Text="物料讀取" VerticalAlignment="Center" FontSize="24" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- 📦 主內容區 -->
            <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="15" BorderBrush="#DDD" BorderThickness="1" Margin="0,10,0,0" Grid.ColumnSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <!-- 標題 -->
                        <RowDefinition Height="Auto" />
                        <!-- 篩選列 -->
                        <RowDefinition Height="*" />
                        <!-- 表格 -->
                    </Grid.RowDefinitions>

                    <!-- 📋 子標題 -->
                    <TextBlock Text="燒錄歷史資訊" FontSize="22" FontWeight="Bold" Background="#FFFFFF" Foreground="Black" Margin="0,0,0,16" />

                    <!-- 🔍 篩選與清除 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <DockPanel LastChildFill="True" Margin="0,0,0,0" VerticalAlignment="Center">
                            <ComboBox Width="120" Height="32" Margin="10,0,0,0" ItemsSource="{Binding DateFilterOptions}" SelectedItem="{Binding SelectedFilterOption}" Style="{StaticResource PillComboBoxStyle}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomDateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DatePicker Width="180" Height="32" Margin="8,0,0,0" SelectedDate="{Binding FromDate}"  IsEnabled="{Binding IsCustomDateMode}" Style="{StaticResource CustomDatePickerStyle}" />
                                <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" VerticalAlignment="Center" Margin="6,0,6,0" />
                                <DatePicker Width="180" Height="32" SelectedDate="{Binding ToDate}" IsEnabled="{Binding IsCustomDateMode}" Style="{StaticResource CustomDatePickerStyle}" />
                            </StackPanel>
                        </DockPanel>

                    </StackPanel>
                    <!-- 清除按鈕 -->
                    <Button Grid.Row="1" HorizontalAlignment="Right" Width="120" Height="40" Background="#444" Foreground="White" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Effect="{StaticResource ShadowEffect}" Command="{Binding ClearCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!-- 滑鼠滑過 -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5A5A5A" />
                                    </Trigger>

                                    <!-- 按下 -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2F2F2F" />
                                    </Trigger>

                                    <!-- 禁用 -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#CCC" />
                                        <Setter Property="Foreground" Value="#888" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <!-- Icon + Text -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Margin="0,2,06,0" />
                            <TextBlock Text="刪除" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 📑 表格 -->
                    <Border Grid.Row="2" CornerRadius="0" BorderBrush="#CCC" BorderThickness="1" Background="White" SnapsToDevicePixels="True" Margin="0,10,0,0">

                        <DataGrid ItemsSource="{Binding rFIDBindmodel.BurnHistoryList}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="36" ColumnHeaderHeight="40" FontSize="16" Style="{StaticResource ModernFlatDataGridStyle}" GridLinesVisibility="None" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" SnapsToDevicePixels="True">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeaderStyle}">
                                    <Setter Property="FontSize" Value="18" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <!-- 移除每個儲存格的邊框 -->
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="6,0,6,0" />
                                    <!-- 不要虛線焦點框（可選） -->
                                    <!--<Setter Property="FocusVisualStyle" Value="{x:Null}"/>-->
                                </Style>
                            </DataGrid.CellStyle>

                            <!-- 列本身也不要邊框/間距 -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="時間" Binding="{Binding Time}" Width="*" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                <DataGridTextColumn Header="物料種類" Binding="{Binding MaterialType}" Width="*" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                <DataGridTextColumn Header="Serial No." Binding="{Binding SerialNo}" Width="*" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                                <DataGridTextColumn Header="標籤序號" Binding="{Binding TagSerial}" Width="*" ElementStyle="{StaticResource CenterAlignedTextStyle}" CellStyle="{StaticResource CenterAlignedCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
