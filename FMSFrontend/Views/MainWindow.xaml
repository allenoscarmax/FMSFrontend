<Window x:Class="FMSFrontend.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:FMSFrontend.Views" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ext="clr-namespace:FMSFrontend.Extensions" 
        xmlns:controls="clr-namespace:FMSFrontend.Controls" 
        xmlns:views="clr-namespace:FMSFrontend.Views" 
        mc:Ignorable="d" Title="FMS 前台" Height="1080" Width="1920" WindowStartupLocation="CenterScreen" WindowStyle="None" WindowState="Maximized">
    <Window.Resources>
        <Storyboard x:Key="CollapseMenuBar">
            <ext:GridLengthAnimation Storyboard.TargetName="PageMenuBarRow" Storyboard.TargetProperty="Height" From="100" To="0" Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="ExpandMenuBar">
            <ext:GridLengthAnimation Storyboard.TargetName="PageMenuBarRow" Storyboard.TargetProperty="Height" From="0" To="100" Duration="0:0:0.3" />
        </Storyboard>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Height="1080" Width="1920" Background="{DynamicResource  PrimaryBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: 視窗標題列 -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <!--<Image Source="pack://application:,,,/Image/Assets/oscar_fms.ico"/>-->
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI">
                            <Run Text="OSCAR" />
                            <Run Text="FMS" Foreground="#FF0000" />
                        </TextBlock>
                        <TextBlock Text=" 彈性製造系統" Foreground="White" VerticalAlignment="Center" Margin="20,0" FontSize="22" FontWeight="Bold" FontFamily="Segoe UI" />
                    </StackPanel>
                    <Button Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Background="Transparent" BorderBrush="{x:Null}" Cursor="Hand">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding PowerButtonClickCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="ButtonGrid" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                                <Border x:Name="ButtonBorder" CornerRadius="5" Background="Transparent">
                                                    <materialDesign:PackIcon x:Name="PowerIcon" Kind="Power" Height="24" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#20FFFFFF" />
                                                    <Setter TargetName="PowerIcon" Property="Foreground" Value="Red" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Row 1: 主畫面區域 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="388" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Grid Grid.Column="0" Background="{DynamicResource  SidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="309" />
                        <RowDefinition Height="296" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource  DeepBlueBrush}" Height="55" Padding="10,0">
                        <DockPanel VerticalAlignment="Center">

                            <!-- 左側：時間 -->
                            <TextBlock Text="{Binding CurrentDateTime}" FontSize="14" Foreground="White" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="10,0,0,0" />

                            <!-- 右側：登入資訊 -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">

                                <!-- 未登入 -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding LoggedInUser, Converter={StaticResource LoginVisibility_Null}}">
                                    <materialDesign:PackIcon Kind="AccountOutline" Width="24" Height="24" Foreground="#808080" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <Button Width="36" Height="36" Background="#A7A7A780" BorderBrush="{x:Null}" Command="{Binding LoginCommand}">
                                        <Button.ToolTip>
                                            <TextBlock Text="點擊登入" />
                                        </Button.ToolTip>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <materialDesign:PackIcon Kind="LoginVariant" Width="36" Height="36" Foreground="White" />
                                    </Button>
                                </StackPanel>

                                <!-- 已登入 -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding LoggedInUser, Converter={StaticResource LoginVisibility_NotNull}}">
                                    <materialDesign:PackIcon Kind="Account" Width="24" Height="24" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LoggedInUser}" VerticalAlignment="Center" FontSize="16px" Foreground="White" Margin="0,0,5,0" />
                                    <Button Width="36" Height="36" Background="#A7A7A780" BorderBrush="{x:Null}" Command="{Binding LogoutCommand}">
                                        <Button.ToolTip>
                                            <TextBlock Text="登出系統" />
                                        </Button.ToolTip>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <materialDesign:PackIcon Kind="LogoutVariant" Width="36" Height="36" Foreground="White" />
                                    </Button>
                                </StackPanel>

                            </StackPanel>

                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource ControlPanelBackgroundBrush}">
                        <StackPanel>
                            <!-- 標題 -->
                            <controls:GradientTextBlock Text="機械臂目前位置" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" />

                            <!-- 機械臂面板 -->
                            <controls:RobotPositionPanel SelectedRobot="{Binding Robot}"  Margin="0,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{DynamicResource  ControlPanelBackgroundBrush}">
                        <StackPanel >
                            <controls:GradientTextBlock Text="控制單元" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" />
                            <!-- 按鈕區 -->
                            <Border Padding="10" HorizontalAlignment="Center">
                                <WrapPanel HorizontalAlignment="Center" ItemWidth="120" ItemHeight="120" Orientation="Horizontal">
                                    <!-- 手臂啟動 -->
                                    <Button Style="{StaticResource ControlCardButtonStyle}" Command="{Binding RobotStartButtonClickCommand}" Margin="5">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Play" Width="60" Height="60" Margin="0,0,0,3" Foreground="#004E79" HorizontalAlignment="Center" />
                                            <TextBlock Text="手臂啟動" FontSize="16" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- 手臂暫停 -->
                                    <Button Style="{StaticResource ControlCardButtonStyle}" Command="{Binding RobotPauseButtonClickCommand}" Margin="5">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Pause" Width="60" Height="60" Margin="0,0,0,5" Foreground="#004E79" HorizontalAlignment="Center" />
                                            <TextBlock Text="手臂暫停" FontSize="16" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- 手臂停止 -->
                                    <Button Style="{StaticResource ControlCardButtonStyle}" Command="{Binding RobotStopButtonClickCommand}" Margin="5">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Stop" Width="60" Height="60" Margin="0,0,0,5" Foreground="#004E79" HorizontalAlignment="Center" />
                                            <TextBlock Text="手臂停止" FontSize="16" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- 手臂重置 -->
                                    <Button Style="{StaticResource ControlCardButtonStyle}" Command="{Binding RobotResetButtonClickCommand}" Margin="5">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Refresh" Width="60" Height="60" Margin="0,0,0,5" Foreground="#004E79" HorizontalAlignment="Center" />
                                            <TextBlock Text="手臂重置" FontSize="16" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- 派工啟動 -->
                                    <Button Style="{StaticResource ControlCardButtonStyle}" Command="{Binding RobotDispatchButtonClickCommand}" Margin="5">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CogPlay" Width="60" Height="60" Margin="0,0,0,5" Foreground="#004E79" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding SDispatchText}" FontSize="16" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Border>
                        </StackPanel>

                    </Border>
                    <Border Grid.Row="3" Background="{DynamicResource  ControlPanelBackgroundBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="55" />
                                <!-- 頂部標題 + 開關 -->
                                <RowDefinition Height="*" />
                                <!-- 可切換的內容 -->
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <!-- 料倉控制標題 -->
                                <controls:GradientTextBlock Text="料倉控制" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="55" />
                                <!-- 滑動按鈕 -->
                                <ToggleButton x:Name="ToggleLight" Width="136" Height="40" HorizontalAlignment="Right" Margin="0,0,30,0" 
                                                IsChecked="{Binding IsDoorLightOn, Mode=TwoWay}"
                                                Command="{Binding DoorLightSwitchChangedCommand}"
                                                CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Width="136" Height="40">
                                                <!-- 背景 -->
                                                <Border Background="#444" CornerRadius="5" BorderBrush="Black" BorderThickness="1" />

                                                <!-- 滑塊 -->
                                                <Border x:Name="Knob" Width="60" Height="36" Background="White" CornerRadius="5" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="KnobTransform" />
                                                    </Border.RenderTransform>
                                                    <Grid>
                                                        <Image x:Name="ImageOn" Width="28" Height="28" Source="/FMSFrontend;component/Image/ControlUnit/06-1-lightbulbOn.png" Stretch="Uniform" Visibility="Visible" />
                                                        <Image x:Name="ImageOff" Width="28" Height="28" Source="pack://application:,,,/FMSFrontend;component/Image/ControlUnit/06-2-lightbulbOff.png" Stretch="Uniform" Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>

                                                <!-- 滑動動畫 -->
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CheckStates">
                                                        <VisualState x:Name="Unchecked">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Checked">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X" To="74" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Grid>

                                            <!-- 圖片切換：用 Triggers 控制 Visibility -->
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ImageOn" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ImageOff" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="ImageOn" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="ImageOff" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <!-- 第二行：換頁內容 -->

                            <ContentControl Grid.Row="1" Content="{Binding StorageControlPage}" Margin="2">
                                <ContentControl.Resources>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="ContentPresenter.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Resources>
                            </ContentControl>

                        </Grid>
                    </Border>
                </Grid>

                <!-- 分隔線 -->
                <Border Grid.Column="1" Background="#FFD1D1D1" Width="2" />

                <!-- Main Content -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="PageMenuBarRow" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource  StatusPanelBrush}">
                        <DockPanel VerticalAlignment="Center" Height="36" Margin="0,0">
                            
                            <materialDesign:PackIcon Kind="ReportProblem" Width="24" Height="24" Margin="5,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Style.Resources>
                                            <Storyboard x:Key="AlarmBlink">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                            <Storyboard x:Key="ColorBlink">
                                                <ColorAnimation Storyboard.TargetProperty="(materialDesign:PackIcon.Foreground).(SolidColorBrush.Color)" From="DodgerBlue" To="Red" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </Style.Resources>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIdle}" Value="True">
                                                <Setter Property="Foreground" Value="Gray" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsHint}" Value="True" />
                                                    <Condition Binding="{Binding IsAlarm}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="DodgerBlue" />
                                                <Setter Property="Opacity" Value="1" />
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsAlarm}" Value="True" />
                                                    <Condition Binding="{Binding IsHint}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="Red" />
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="AlarmBlink_BS" Storyboard="{StaticResource AlarmBlink}" />
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="AlarmBlink_BS" />
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsHint}" Value="True" />
                                                    <Condition Binding="{Binding IsAlarm}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="ColorBlink_BS" Storyboard="{StaticResource ColorBlink}" />
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="ColorBlink_BS" />
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>

                            <Button Command="{Binding OpenAlarmCommand}" Height="24" Width="200" VerticalAlignment="Center" Background="White" Foreground="Black" BorderThickness="0" Padding="0" Cursor="Hand" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}">
                                            <TextBlock x:Name="lbl" Text="{Binding SummaryMessage, FallbackValue='提示訊息'}" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0" />
                                                <Setter TargetName="lbl" Property="Foreground" Value="Black" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E5E5E5" />
                                                <Setter TargetName="lbl" Property="Foreground" Value="Black" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="Bug" Width="25" Height="25" Margin="10,0" Foreground="White" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="Tablet" Width="25" Height="25" Margin="10,0" Foreground="White" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="AccountAlert" Width="25" Height="25" Margin="10,0" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ContentControl Grid.Row="1" Background="{DynamicResource PageViewBrush}" Content="{Binding CurrentPageView}">
                    </ContentControl>
                    <!-- Row 2：底部的 PageMenuBar 區域 -->
                    <Grid Grid.Row="2" Height="100">
                        <!-- 這層是為了解決導角外溢的底色一致性 -->
                        <Border Background="{DynamicResource PageViewBrush}" />

                        <!-- PageMenuBar 本體（含導角與內容） -->
                        <Border Height="100" Background="{DynamicResource PageMenuBarBrush}" CornerRadius="30,30,0,0" HorizontalAlignment="Stretch">
                            <controls:PageMenuBar CurrentPageKey="{Binding CurrentPageKey}" Loaded="PageMenuBar_Loaded" />
                        </Border>
                    </Grid>

                </Grid>
                
            </Grid>
            
        </Grid>
    </Viewbox>
</Window>
