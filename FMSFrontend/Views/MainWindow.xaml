<Window x:Class="FMSFrontend.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:FMSFrontend.Views" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:ext="clr-namespace:FMSFrontend.Extensions" xmlns:controls="clr-namespace:FMSFrontend.Controls" mc:Ignorable="d" Title="FMS 前台" Height="1080" Width="1920" WindowStartupLocation="CenterScreen" WindowStyle="None" WindowState="Maximized">
    <Window.Resources>
        <Storyboard x:Key="CollapseMenuBar">
            <ext:GridLengthAnimation Storyboard.TargetName="PageMenuBarRow" Storyboard.TargetProperty="Height" From="100" To="0" Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="ExpandMenuBar">
            <ext:GridLengthAnimation Storyboard.TargetName="PageMenuBarRow" Storyboard.TargetProperty="Height" From="0" To="100" Duration="0:0:0.3" />
        </Storyboard>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Height="1080" Width="1920" Background="{DynamicResource  PrimaryBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: 視窗標題列 -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI">
                            <Run Text="OSCAR" />
                            <Run Text="FMS" Foreground="#FF0000" />
                        </TextBlock>
                        <TextBlock Text=" 彈性製造系統" Foreground="White" VerticalAlignment="Center" Margin="20,0" FontSize="22" FontWeight="Bold" FontFamily="Segoe UI" />
                    </StackPanel>
                    <Button Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Background="Transparent" BorderBrush="{x:Null}" Cursor="Hand">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding PowerButtonClickCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="ButtonGrid" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                                <Border x:Name="ButtonBorder" CornerRadius="5" Background="Transparent">
                                                    <materialDesign:PackIcon x:Name="PowerIcon" Kind="Power" Height="24" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#20FFFFFF" />
                                                    <Setter TargetName="PowerIcon" Property="Foreground" Value="Red" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Row 1: 主畫面區域 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="388" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Grid Grid.Column="0" Background="{DynamicResource  SidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="309" />
                        <RowDefinition Height="296" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource  DeepBlueBrush}" Height="55" Padding="10,0">
                        <DockPanel VerticalAlignment="Center">

                            <!-- 左側：時間 -->
                            <TextBlock Text="{Binding CurrentDateTime}" FontSize="14" Foreground="White" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="10,0,0,0" />

                            <!-- 右側：登入資訊 -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">

                                <!-- 未登入 -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding LoggedInUser, Converter={StaticResource LoginVisibility_Null}}">
                                    <materialDesign:PackIcon Kind="AccountOutline" Width="24" Height="24" Foreground="#808080" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <Button Width="36" Height="36" Background="#A7A7A780" BorderBrush="{x:Null}" Command="{Binding LoginCommand}">
                                        <Button.ToolTip>
                                            <TextBlock Text="點擊登入" />
                                        </Button.ToolTip>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <materialDesign:PackIcon Kind="LoginVariant" Width="36" Height="36" Foreground="White" />
                                    </Button>
                                </StackPanel>

                                <!-- 已登入 -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding LoggedInUser, Converter={StaticResource LoginVisibility_NotNull}}">
                                    <materialDesign:PackIcon Kind="Account" Width="24" Height="24" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LoggedInUser}" VerticalAlignment="Center" FontSize="16px" Foreground="White" Margin="0,0,5,0" />
                                    <Button Width="36" Height="36" Background="#A7A7A780" BorderBrush="{x:Null}" Command="{Binding LogoutCommand}">
                                        <Button.ToolTip>
                                            <TextBlock Text="登出系統" />
                                        </Button.ToolTip>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <materialDesign:PackIcon Kind="LogoutVariant" Width="36" Height="36" Foreground="White" />
                                    </Button>
                                </StackPanel>

                            </StackPanel>

                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource  ControlPanelBackgroundBrush}">
                        <StackPanel>
                            <controls:GradientTextBlock Text="機械臂目前位置" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{DynamicResource  ControlPanelBackgroundBrush}">
                        <StackPanel>
                            <controls:GradientTextBlock Text="控制單元" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Background="{DynamicResource  ControlPanelBackgroundBrush}">
                        <StackPanel>
                            <controls:GradientTextBlock Text="料倉控制" FontSize="24" FontWeight="Bold" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 分隔線 -->
                <Border Grid.Column="1" Background="#FFD1D1D1" Width="2" />

                <!-- Main Content -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="PageMenuBarRow" Height="100" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource  StatusPanelBrush}">
                        <DockPanel VerticalAlignment="Center" Height="36" Margin="5,0">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20" Margin="5,0" Foreground="White" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <Border CornerRadius="4" Background="White" Height="24" VerticalAlignment="Center">
                                <TextBox Text="提示訊息" Margin="10,0" Height="24" VerticalAlignment="Center" Background="White" Padding="8,0" BorderThickness="0" Width="200" HorizontalContentAlignment="Center" FontSize="14" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="Bug" Width="25" Height="25" Margin="10,0" Foreground="White" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="Tablet" Width="25" Height="25" Margin="10,0" Foreground="White" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="AccountAlert" Width="25" Height="25" Margin="10,0" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ContentControl Grid.Row="1">
                        <Grid Background="{DynamicResource PageViewBrush}">
                            <TextBlock Text="這是測試頁面" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                        </Grid>
                    </ContentControl>
                    <Grid Grid.Row="2" Background="{DynamicResource  PageMenuBarBrush}">
                        <!-- 頁面選單列略 -->
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
