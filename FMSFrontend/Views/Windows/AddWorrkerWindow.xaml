<Window x:Class="FMSFrontend.Views.Windows.AddWorrkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="d" Title="{DynamicResource AddWorkerWindow_Title}" Height="370" Width="456" ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" 
        Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="8" ShadowDepth="2" Color="Black" Opacity="0.25" />
        <Style x:Key="LoginButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#2779A7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="42" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D8C7FF" />
                    <Setter Property="Foreground" Value="#666" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="10" Effect="{StaticResource ShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- 標題列 -->
            <Border Grid.Row="0" Background="#444" CornerRadius="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" />
                    </StackPanel>
                    <Button Content="✕" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="Close_Click" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>
                    <!-- 標題列 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource AddWorkerWindow_Label_WorkerNumber}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <TextBox Grid.Row="0" Grid.Column="1" Width="250" Height="32" Text="{Binding WorkerNumber}" IsEnabled="{Binding IsEnable}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource AddWorkerWindow_Label_UserName}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="250" Height="32" Text="{Binding WorkerName}" IsEnabled="{Binding IsEnable}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource AddWorkerWindow_Label_Password}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <PasswordBox x:Name="PasswordInput" Grid.Row="2" Grid.Column="1" Width="250" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold" PasswordChar="*" PasswordChanged="PasswordBox_PasswordChanged" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource AddWorkerWindow_Label_ConfirmPassword}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <PasswordBox x:Name="ConfirmPasswordInput" Grid.Row="3" Grid.Column="1" Width="250" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold" PasswordChar="*" PasswordChanged="PasswordBox_PasswordChanged" />
                    <TextBlock Grid.Row="4" Grid.Column="0"  Grid.ColumnSpan="2"  Text="{Binding Message}" Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="{DynamicResource AddWorkerWindow_Button_Add}" Style="{StaticResource LoginButtonStyle}" Command="{Binding AddWorkerClickCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

