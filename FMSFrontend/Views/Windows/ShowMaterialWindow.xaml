<Window x:Name="Root" x:Class="FMSFrontend.Views.Windows.ShowMaterialWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:FMSFrontend.ViewModels" xmlns:views="clr-namespace:FMSFrontend.Controls" xmlns:local="clr-namespace:FMSFrontend.Converters" mc:Ignorable="d" Title="倉位資訊" Width="1060" Height="700" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>
    
    <!-- 外框：白底 + 圓角 + 陰影 + 16px 內距 -->
    <Border CornerRadius="10" Background="#FFFFFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity="0.25" />
        </Border.Effect>

        <!-- 內層網格：標題列 / 名稱與按鈕列 / 主內容 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <!-- 1) 深灰標題列 -->
                <RowDefinition Height="56" />
                <!-- 2) 倉位編號 + 右側操作 -->
                <RowDefinition Height="*" />
                <!-- 3) 主內容：左右兩卡 -->
            </Grid.RowDefinitions>

            <!-- 1) 自訂標題列 -->

            <!-- 2) 次標題列：左 倉位編號 / 右 解除預約 + 禁用切換 -->
            <Border Grid.Row="0" Background="#555555" CornerRadius="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>


                    <TextBlock Text="倉位資訊" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="White" FontSize="24" FontWeight="Bold" />

                    <!-- 關閉按鈕 -->
                    <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="20" FontWeight="Bold" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" Click="Close_Click" />
                </Grid>
            </Border>

            <!-- 2) 次標題列：左 倉位編號 / 右 解除預約 + 禁用切換 -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145*" />
                    <ColumnDefinition Width="77*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：倉位編號 + 類別 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="10,0,0,0">
                    <TextBlock Text="倉位編號" FontSize="18" FontWeight="Bold" Margin="0,0,16,0" />
                    <!-- 這裡要顯示實際倉位代碼 -->
                    <TextBlock Text="{Binding SlotCode, TargetNullValue=—}" FontSize="18" Margin="0,0,16,0" />
                    <!-- 類別文字（電極 / 工件 / 物料） -->
                    <TextBlock Text="{Binding KindText}" FontSize="18" Opacity="1" />
                </StackPanel>

                <!-- 右：解除預約 / 禁用 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                    
                    <Button  Name ="CancelBook" Command="{Binding CancelBookStorageCommand}" Content="解除預約" Padding="16,8" Style="{StaticResource PrimaryButtonStyle}" Background="#E58C2C" Foreground="White" BorderBrush="#E58C2C" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" />
                    
                    <!-- 滑動開關版本：IsChecked=False=禁用(左)；IsChecked=True=啟用(右) -->
                    <ToggleButton x:Name="DisableToggle" Cursor="Hand" HorizontalAlignment="Left" ToolTip="禁用 / 啟用" Command="{Binding UpdataStorageCommand}" IsChecked="{Binding IsDisabled, Mode=TwoWay, Converter={StaticResource InverseBoolConverter}}">
                        <ToggleButton.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                                <!-- 尺寸統一交由模板控制 -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Grid Width="150" Height="40">

                                                <!-- 視覺狀態與動畫 -->
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CheckStates">
                                                        <!-- 未勾選：禁用（滑塊在左） -->
                                                        <VisualState x:Name="Unchecked">
                                                            <Storyboard>
                                                                <!-- 滑塊位移 -->
                                                                <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.20">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>

                                                                <!-- 軌道顏色 -->
                                                                <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#D9D9D9" Duration="0:0:0.20" />

                                                                <!-- 陰影拖曳淡出 -->
                                                                <DoubleAnimation Storyboard.TargetName="ShadowTrail" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </VisualState>

                                                        <!-- 勾選：啟用（滑塊在右） -->
                                                        <VisualState x:Name="Checked">
                                                            <Storyboard>
                                                                <!-- 180(總寬)-2*2(邊距)-92(滑塊寬)=82；略加手感微調 -> 84 -->
                                                                <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X" To="71" Duration="0:0:0.20">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>

                                                                <!-- 軌道顏色 -->
                                                                <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#CCCCCC" Duration="0:0:0.20" />

                                                                <!-- 陰影拖曳淡入（在滑到右側時，左側留一點陰影） -->
                                                                <DoubleAnimation Storyboard.TargetName="ShadowTrail" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <!-- 背景軌道 -->
                                                <Border x:Name="Track" CornerRadius="22" BorderBrush="#333" BorderThickness="0">
                                                    <Border.Background>
                                                        <SolidColorBrush x:Name="TrackBrush" Color="#D9D9D9" />
                                                    </Border.Background>
                                                </Border>

                                                <!-- 追隨陰影：模擬滑塊後方的陰影拖曳 -->
                                                <Border x:Name="ShadowTrail" Margin="0" CornerRadius="22" Opacity="0.0" IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#55000000" Offset="0.0" />
                                                            <GradientStop Color="#00000000" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- 滑塊 -->
                                                <Border x:Name="Knob" Width="75" Height="40" Margin="1" CornerRadius="18" Background="White" VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.25" />
                                                    </Border.Effect>
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="KnobTransform" />
                                                    </Border.RenderTransform>

                                                    <!-- 滑塊內容：圖示 + 文字 -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,1" >
                                                        <TextBlock x:Name="IconText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Text="🚫" Foreground="Black" />
                                                        <TextBlock x:Name="LabelText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="禁用" Foreground="Black" />
                                                    </StackPanel>
                                                </Border>

                                            </Grid>

                                            <!-- 狀態切換（圖示/文字/前景） -->
                                            <ControlTemplate.Triggers>
                                                <!-- 禁用（IsChecked=False） -->
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="Knob" Property="Background" Value="White" />
                                                    <Setter TargetName="IconText" Property="Text" Value="🚫" />
                                                    <Setter TargetName="IconText" Property="Foreground" Value="#555555" />
                                                    <Setter TargetName="LabelText" Property="Text" Value="禁用" />
                                                    <Setter TargetName="LabelText" Property="Foreground" Value="#555555" />
                                                    <!-- 陰影方向（靠滑塊右側） -->
                                                    <Setter TargetName="ShadowTrail" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="ShadowTrail" Property="Width" Value="90" />
                                                </Trigger>

                                                <!-- 啟用（IsChecked=True） -->
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Knob" Property="Background" Value="#555555" />
                                                    <Setter TargetName="IconText" Property="Text" Value="✓ " />
                                                    <Setter TargetName="IconText" Property="Foreground" Value="White" />
                                                    <Setter TargetName="LabelText" Property="Text" Value="啟用" />
                                                    <Setter TargetName="LabelText" Property="Foreground" Value="White" />
                                                    <!-- 陰影方向（靠滑塊左側） -->
                                                    <Setter TargetName="ShadowTrail" Property="HorizontalAlignment" Value="Left" />
                                                    <Setter TargetName="ShadowTrail" Property="Width" Value="90" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                </StackPanel>
            </Grid>

            <!-- 3) 主內容：左右兩張卡片 -->
            <Grid Grid.Row="2" Margin="10,12,12,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左卡：物料資訊 -->
                <Border Grid.Column="0" CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FFFFFF">
                    <Grid>
                        <!-- 內容：依 DetailViewModel 型別切換不同 UserControl -->
                        <ContentControl Content="{Binding DetailViewModel}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type vm:ElectrodeDetailViewModel}">
                                    <views:ElectrodeDetailView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:WorkpieceDetailViewModel}">
                                    <views:WorkpieceDetailView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:EmptyMaterialDetailViewModel}">
                                    <views:EmptyMaterialView />
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </Grid>
                </Border>

                <!-- 中間間距 -->
                <Border Grid.Column="1" Background="Transparent" />

                <!-- 右卡：工作列表（時間軸） -->
                <Border Grid.Column="2" CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FFFFFF">
                    <Grid>
                        <!-- 關鍵：直接綁 VM 的 Timeline -->
                        <views:MaterialTimelineView ItemsSource="{Binding Timeline}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
