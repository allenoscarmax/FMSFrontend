<UserControl x:Class="FMSFrontend.Views.StorageUnitControlPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FMSFrontend.Controls" xmlns:local="clr-namespace:FMSFrontend.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Name="root" Height="348" Width="384">

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <!-- 依照 MagazinePara.MagazineParas 動態產生 StorageUnitControl -->
            <ItemsControl x:Name="MagazineItems" ItemsSource="{Binding MagazinePara.MagazineParas}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Margin="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:StorageUnitControl
                            Margin="5"
                            StorageId="{Binding StorageId}"
                            SidebarBrush="#2779A7"
                            UpperDoorCommand="{Binding DataContext.UpperDoorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            LowerDoorCommand="{Binding DataContext.LowerDoorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            LeftTitleBrush="{Binding LeftTitleBrush}"
                            LeftTitle="{Binding LeftTitle}"
                            RightTitleBrush="{Binding RightTitleBrush}"
                            RightTitle="{Binding RightTitle}"
                            UpperScanStatus="{Binding UpperScanStatus}"
                            UpperDoorStatus="{Binding UpperDoorStatus}"
                            LowerScanStatus="{Binding LowerScanStatus}"
                            LowerDoorStatus="{Binding LowerDoorStatus}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!-- 半透明的返回按鈕 -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="36" Height="36" Background="Gray" Opacity="0.5" BorderBrush="Transparent" BorderThickness="1" FontSize="24" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Command="{Binding BackCommand}" ToolTip="{DynamicResource StorageUnitControlPage_Tooltip_Back}" Margin="5">

            <!-- 按鈕圖示內容 -->
            <materialDesign:PackIcon Kind="ArrowULeftTop" Foreground="White" Width="24" Height="24" />

            <Button.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.5" />
            </Button.Effect>
        </Button>
    </Grid>
</UserControl>