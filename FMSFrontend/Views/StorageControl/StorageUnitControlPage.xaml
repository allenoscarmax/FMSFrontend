<UserControl x:Class="FMSFrontend.Views.StorageUnitControlPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FMSFrontend.Controls" xmlns:local="clr-namespace:FMSFrontend.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Name="root" Height="329" Width="384">

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainStackPanel" Orientation="Vertical" Margin="10">
                <controls:StorageUnitControl StorageId="1" StorageTitle="1號倉門" SidebarBrush="#2779A7" Margin="0,0,0,20" />
                <controls:StorageUnitControl StorageId="2" StorageTitle="2號倉門" SidebarBrush="#2779A7" Margin="0,0,0,20" />
                <controls:StorageUnitControl StorageId="3" StorageTitle="3號倉門" SidebarBrush="#2779A7" Margin="0,0,0,20" />
                <controls:StorageUnitControl StorageId="4" StorageTitle="4號倉門" SidebarBrush="#2779A7" Margin="0,0,0,20" />
                <controls:StorageUnitControl StorageId="5" StorageTitle="5號倉門" SidebarBrush="#2779A7" Margin="0,0,0,20" />
                <controls:StorageUnitControl StorageId="6" StorageTitle="6號倉門" SidebarBrush="#2779A7" Margin="0,0,0,20" />
                <controls:StorageUnitControl StorageId="7" StorageTitle="1號倉門" SidebarBrush="#E08E45" Margin="0,0,0,20" />
                <controls:StorageUnitControl StorageId="8" StorageTitle="2號倉門" SidebarBrush="#E08E45" Margin="0,0,0,20" />
            </StackPanel>
        </ScrollViewer>
        <!-- 半透明的返回按鈕 -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="36" Height="36" Background="Gray" Opacity="0.5" BorderBrush="Transparent" BorderThickness="1" FontSize="24" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Command="{Binding BackCommand}" Margin="10">

            <!-- 按鈕圖示內容 -->
            <materialDesign:PackIcon Kind="ArrowULeftTop" Foreground="White" Width="24" Height="24" />

            <Button.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.5" />
            </Button.Effect>
        </Button>
    </Grid>
</UserControl>