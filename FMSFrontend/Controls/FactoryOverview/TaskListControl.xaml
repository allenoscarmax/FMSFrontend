<UserControl x:Class="FMSFrontend.Controls.FactoryOverview.TaskListControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:Extens="clr-namespace:FMSFrontend.Extensions"
             xmlns:conv="clr-namespace:FMSFrontend.Converters" mc:Ignorable="d" d:DesignWidth="498" d:DesignHeight="822">

    <UserControl.Resources>
        <conv:PercentToEndAngleConverter x:Key="PercentToEndAngleConverter" />
        <conv:PercentToLargeArcConverter x:Key="PercentToLargeArcConverter" />
        <Extens:Arc x:Key="ArcControl" />
    </UserControl.Resources>

    <Grid>
        <!-- 陰影層 -->
        <Border CornerRadius="18" Background="#FFFFFF" BorderBrush="#DDD" ClipToBounds="True" SnapsToDevicePixels="True" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <!-- 標題列 -->
                <RowDefinition Height="*" />
                <!-- 主內容 -->
            </Grid.RowDefinitions>

            <!-- 標題列 -->
            <Border Grid.Row="0" Background="#EEEEEE" CornerRadius="18,18,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <materialDesign:PackIcon Kind="ClipboardList" Width="24" Height="24" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource TaskList_Title}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="4,0,4,5" Background="White" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116*"/>
                        <ColumnDefinition Width="133*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ① 全域時間軸垂直線：畫滿整個清單高度（在最底層） -->
                    <!-- 70 = 左欄 140 的一半 = 圓心 X；寬度 4 可調 -->
                    <Border HorizontalAlignment="Left" Margin="70,0,0,0" Width="4" Background="#9BB8CC" CornerRadius="2" Panel.ZIndex="0" />

                    <!-- 清單本體 -->
                    <ItemsControl ItemsSource="{Binding TaskItems}" Grid.ColumnSpan="2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,16,16,16" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 左：圓／右：卡片 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ② 橫向連接線：從圓的「右切線」拉到卡片（會在卡片底下，被白底蓋住，視覺上剛好到邊） -->
                                    <!-- 120 = 圓心(70) + 半徑(50)；高度 4 可調 -->
                                    <Border Grid.ColumnSpan="2" Height="4" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="120,0,0,0" Background="#2A6FA1" CornerRadius="2" Panel.ZIndex="0" />

                                    <!-- 左邊圓（置中於左欄；直線在底層，不會被圓壓縮） -->
                                    <Grid Grid.Column="0" Width="100" Height="100" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center" Panel.ZIndex="1">
                                        <Ellipse Fill="#E5E7EB" />
                                        <Extens:Arc Stroke="#1F6AA4" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StartAngle="270" EndAngle="{Binding ProgressPercent, Converter={StaticResource PercentToEndAngleConverter}}" IsLargeArc="{Binding ProgressPercent, Converter={StaticResource PercentToLargeArcConverter}}" />
                                        <Ellipse Fill="White" Margin="14" />
                                        <TextBlock Text="{Binding MachineName}" FontSize="18" FontWeight="Bold" Foreground="#0D3352" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 右側任務卡 -->
                                    <Border Grid.Column="1" Width="300" Height="120" CornerRadius="12" Background="White" BorderBrush="#D7E2EB" BorderThickness="2" Padding="10" Panel.ZIndex="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="4" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="4" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Summary, FallbackValue=安裝電極到放電加工機 (EDM)}" FontSize="18" FontWeight="SemiBold" Foreground="#111" />
                                            <TextBlock Grid.Row="2" Text="{Binding InsertTimeString, FallbackValue=工單編號： }" FontSize="16" Foreground="#222" />
                                            <TextBlock Grid.Row="4" Text="{Binding StartPoint, FallbackValue=工件/電極： }" FontSize="16" Foreground="#222" />
                                            <TextBlock Grid.Row="6" Text="{Binding EndPoint, FallbackValue=工件/電極： }" FontSize="16" Foreground="#222" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
