<UserControl x:Class="FMSFrontend.Controls.MachineStationControl"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:selectors="clr-namespace:FMSFrontend.Selectors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FMSFrontend.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="661"
             d:DesignWidth="1432">
    <UserControl.Resources>
        <selectors:TabItemBackgroundSelector x:Key="TabtemColorSelector" />
    </UserControl.Resources>
    <Border  Margin="0,5,0,0" Background="{DynamicResource PageViewBrush}" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
        </Border.Effect>
        <Grid>
            <!-- 🧩 頂層切 2 Row：標題 + 內容 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <!-- 標題列 -->
                <RowDefinition Height="*" />
                <!-- 內容列 -->
            </Grid.RowDefinitions>

            <!-- 🔹 標題區塊 -->
            <Border Grid.Row="0" Background="#CCCCCC" CornerRadius="10,10,0,0" Margin="0">
                <!-- 修正：使用 Grid 分三欄，避免在無 Grid 的 Border 內使用 Grid.Column -->
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側原資訊 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="MonitorDashboard" Width="24" Height="24" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MachineName}" d:Text="EDM1" TextDecorations="Underline" FontSize="30" FontWeight="DemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="10,0,20,0"/>
                        <TextBlock Text="{DynamicResource MachineStation_Label_MachineInfoSuffix}" FontSize="20" VerticalAlignment="Center" FontWeight="DemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>

                    <!-- 右側按鈕：刷新 + 自動更新 -->
                </Grid>
            </Border>
            <!-- 主內容區：移除 RowSpan 以避免覆蓋標題區 -->
            <Border Grid.Row="1">
                <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 🔹 左上圖片 -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Margin="8,160,8,160" BorderBrush="LightGray" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                    </Border.Effect>
                    <Image Source="{Binding MachineImagePath}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="10" Margin="8" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 區塊標題 -->
                        <Border Grid.Row="0"  Background="#444" CornerRadius="10,10,0,0" VerticalAlignment="Stretch">
                            <TextBlock Text="{DynamicResource MachineStation_Section_Info}" FontSize="24" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1"  Background="#FFFFFF" CornerRadius="0,0,10,10" VerticalAlignment="Stretch">
                            <Grid>
                                <!-- 2 Columns -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="30" />


                                </Grid.ColumnDefinitions>

                                <!-- 11 Rows -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>

                                </Grid.RowDefinitions>
                                <!-- 🔥 Button 樣式（寬100、高40、圓角3、藍底白字） -->
                                <Grid.Resources>
                                    <Style x:Key="LabelText" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>

                                    </Style>
                                    <Style x:Key="DataText" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </Grid.Resources>

                                <!-- Row1~Row10 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_AirError}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DataText}"  Text="{Binding displayData.Air_error}"/>
                                <Border Grid.Row="0" Grid.Column="1" Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_DoorOpen}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource DataText}"  Text="{Binding displayData.DoorisOpen}"/>
                                <Border Grid.Row="0" Grid.Column="3" Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_RfidAtOrigin}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DataText}"  Text="{Binding displayData.RFIDisPolarization						}"/>
                                <Border Grid.Row="1" Grid.Column="1" Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_WorkpieceOnAssembly}"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource DataText}"  Text="{Binding displayData.WorkpieceOnAssemblyStation}"/>
                                <Border Grid.Row="1" Grid.Column="3" Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_IncomingNotification}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DataText}"  Text="{Binding displayData.Notification_IncomingPart}"/>
                                <Border Grid.Row="2"  Grid.Column="1" Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_WaitWorkpieceReturn}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource DataText}"  Text="{Binding displayData.Notification_WaitingWorkpieceReturn}"/>
                                <Border Grid.Row="2" Grid.Column="3"  Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_Alarm}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DataText}"  Text="{Binding displayData.Alarm}"/>
                                <Border Grid.Row="3" Grid.Column="1"  Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_RequestIncoming}"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource DataText}"  Text="{Binding displayData.Require_IncomingPart}"/>
                                <Border Grid.Row="3" Grid.Column="3" Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_RequestOutcoming}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DataText}"  Text="{Binding displayData.Require_OutcomingPart}"/>
                                <Border Grid.Row="4"  Grid.Column="1" Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource LabelText}" Text="{DynamicResource MachineStation_Label_DoorClosed}"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource DataText}"  Text="{Binding displayData.Notification_Doorislocked}"/>
                                <Border Grid.Row="4"  Grid.Column="3" Margin="3,0,3,0" Grid.ColumnSpan="1" Height="2" Background="#555555" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="10" Margin="8" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 區塊標題 -->
                        <Border Grid.Row="0"  Background="#444" CornerRadius="10,10,0,0" VerticalAlignment="Stretch">
                            <TextBlock Text="{DynamicResource MachineStation_Section_Control}" FontSize="24" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1"  Background="#FFFFFF" CornerRadius="0,0,10,10" VerticalAlignment="Stretch">
                            <Grid>
                                <!-- 2 Columns -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 11 Rows -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 🔥 Button 樣式（寬100、高40、圓角3、藍底白字） -->
                                <Grid.Resources>
                                    <Style x:Key="BlueButton" TargetType="Button">
                                        <Setter Property="Height" Value="40"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#0078D7"/>
                                        <!-- Normal -->
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>

                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                        CornerRadius="6"
                        Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <!-- Hover：變亮一點 -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0088F0"/>
                                                        </Trigger>

                                                        <!-- Pressed：變深一點 -->
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0060B5"/>
                                                        </Trigger>

                                                        <!-- Disabled -->
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="bd" Property="Background" Value="#7AAEDB"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>

                                <!-- 開門 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="18" Text="{DynamicResource MachineStation_Label_AssemblyDoor}" VerticalAlignment="Center" Margin="5"/>
                                <Button    Grid.Row="0" Grid.Column="1" FontSize="18" Style="{StaticResource BlueButton}"
										Content="{DynamicResource MachineStation_Button_OpenDoor}" Command="{Binding OpenDoorClickCommand}" Margin="5"/>

                                <!-- 開燈 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="18" Text="{DynamicResource MachineStation_Label_AssemblyLight}" VerticalAlignment="Center" Margin="5"/>
                                <Button    Grid.Row="1" Grid.Column="1" FontSize="18" Style="{StaticResource BlueButton}"
										Content="{DynamicResource MachineStation_Button_LightOn}" Command="{Binding OpenDoorLightClickCommand}" CommandParameter="True" Margin="5"/>
                                <Button    Grid.Row="1" Grid.Column="2" FontSize="18" Style="{StaticResource BlueButton}"
										Content="{DynamicResource MachineStation_Button_LightOff}" Command="{Binding OpenDoorLightClickCommand}" CommandParameter="False" Margin="5"/>

                                <!-- 夾頭 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" FontSize="18" Text="{DynamicResource MachineStation_Label_Chuck}" VerticalAlignment="Center" Margin="5"/>
                                <Button    Grid.Row="2" Grid.Column="1" FontSize="18" Style="{StaticResource BlueButton}"
										Content="{DynamicResource MachineStation_Button_ChuckOpen}" Command="{Binding OpenChuckClickCommand}" CommandParameter="True" Margin="5"/>
                                <Button    Grid.Row="2" Grid.Column="2" FontSize="18" Style="{StaticResource BlueButton}"
										Content="{DynamicResource MachineStation_Button_ChuckClose}" Command="{Binding OpenChuckClickCommand}" CommandParameter="False" Margin="5"/>

                                <!-- IncomingPart -->
                                <TextBlock Grid.Row="3" Grid.Column="0" FontSize="18" Text="{DynamicResource MachineStation_Label_IncomingPart}" VerticalAlignment="Center" Margin="5"/>
                                <Button    Grid.Row="3" Grid.Column="1" FontSize="18" Style="{StaticResource BlueButton}"
										Content="{DynamicResource MachineStation_Button_Request}" Command="{Binding IncomingPartClickCommand}" CommandParameter="True" Margin="5"/>
                                <Button    Grid.Row="3" Grid.Column="2" FontSize="18" Style="{StaticResource BlueButton}" Content="Close" Command="{Binding IncomingPartClickCommand}" CommandParameter="False" Margin="5" Visibility="Hidden" />

                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
             </Border>

    </Grid>
    </Border>
</UserControl>
