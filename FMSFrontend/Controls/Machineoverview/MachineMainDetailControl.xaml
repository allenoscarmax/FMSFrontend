<UserControl x:Class="FMSFrontend.Controls.MachineMainDetailControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:selectors="clr-namespace:FMSFrontend.Selectors" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:vm="clr-namespace:FMSFrontend.ViewModels" xmlns:ex="clr-namespace:FMSFrontend.Extensions" mc:Ignorable="d" d:DesignHeight="661" d:DesignWidth="1432">
    <UserControl.Resources>
        <selectors:TabItemBackgroundSelector x:Key="TabtemColorSelector" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Border BorderBrush="#000000" BorderThickness="0" CornerRadius="10,10,10,10" Margin="0,5,0,0" Background="{DynamicResource PageViewBrush}" >
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
        </Border.Effect>
        <Grid Background="Transparent" Loaded="ToggleRoot_Loaded">

            <!-- 🧩 頂層切 2 Row：標題 + 內容 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <!-- 標題列 -->
                <RowDefinition Height="*" />
                <!-- 內容列 -->
            </Grid.RowDefinitions>

            <!-- 🔹 標題區塊 -->
            <Border Grid.Row="0" Background="#CCCCCC" BorderThickness="0" BorderBrush="#000000" CornerRadius="10,10,0,0">
                <!-- 修正：使用 Grid 分三欄，避免在無 Grid 的 Border 內使用 Grid.Column -->
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側原資訊 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="MonitorDashboard" Width="24" Height="24" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MachineName}" d:Text="EDM1" TextDecorations="Underline" FontSize="30" FontWeight="DemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="10,0,20,0" />
                        <TextBlock Text="{DynamicResource MachineMainDetail_Label_MachineInfoSuffix}" FontSize="20" VerticalAlignment="Center" FontWeight="DemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>

                    <!-- 右側按鈕：刷新 + 自動更新 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ResetClickCommand}" Grid.Row="0" HorizontalAlignment="Left" Margin="10,5,10,5" Background="#0070E0" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Style="{StaticResource  PrimaryButtonStyle}" Width="120" Height="37">
                            <Border CornerRadius="8" Background="Transparent">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource MachineMainDetail_Button_Reset}" FontSize="18" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <!-- 滑動開關版本：IsChecked=False=禁用(左)；IsChecked=True=啟用(右) -->
                        <ToggleButton ClickMode="Press" x:Name="DisableToggle" Cursor="Hand" HorizontalAlignment="Left" ToolTip="{DynamicResource MachineMainDetail_Toggle_Tooltip}" Command="{Binding RestrictionClickCommand}" IsChecked="{Binding DisplayData.CanControl, Mode=TwoWay}" ex:ToggleSwitchBehavior.EnableSmartAnimation="True">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <!-- 尺寸統一交由模板控制 -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid x:Name="RootElement" Width="150" Height="40">

                                                    <!-- 視覺狀態與動畫 -->
                                                    <VisualStateManager.VisualStateGroups>

                                                        <VisualStateGroup x:Name="CheckStates">
                                                            <!-- 未勾選：瞬間版 -->
                                                            <VisualState x:Name="UncheckedInstant">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0" />
                                                                    <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#D9D9D9" Duration="0:0:0" />
                                                                </Storyboard>
                                                            </VisualState>

                                                            <!-- 勾選：瞬間版 -->
                                                            <VisualState x:Name="CheckedInstant">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X" To="31" Duration="0:0:0" />
                                                                    <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#CCCCCC" Duration="0:0:0" />
                                                                </Storyboard>
                                                            </VisualState>

                                                            <!-- 未勾選：禁用（滑塊在左） -->
                                                            <VisualState x:Name="Unchecked">
                                                                <Storyboard>

                                                                    <!-- 滑塊位移 -->
                                                                    <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>

                                                                    <!-- 軌道顏色 -->
                                                                    <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#D9D9D9" Duration="0:0:0.2" />

                                                                    <!-- 陰影拖曳淡出 -->
                                                                    <DoubleAnimation Storyboard.TargetName="ShadowTrail" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15" />
                                                                </Storyboard>
                                                            </VisualState>

                                                            <!-- 勾選：啟用（滑塊在右） -->
                                                            <VisualState x:Name="Checked">
                                                                <Storyboard>
                                                                    <!-- 180(總寬)-2*2(邊距)-92(滑塊寬)=82；略加手感微調 -> 84 -->
                                                                    <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X" To="31" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>

                                                                    <!-- 軌道顏色 -->
                                                                    <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#CCCCCC" Duration="0:0:0.20" />

                                                                    <!-- 陰影拖曳淡入（在滑到右側時，左側留一點陰影） -->
                                                                    <DoubleAnimation Storyboard.TargetName="ShadowTrail" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.12" />
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                    <!-- 背景軌道 -->
                                                    <Border x:Name="Track" CornerRadius="22" BorderBrush="#333" BorderThickness="0">
                                                        <Border.Background>
                                                            <SolidColorBrush x:Name="TrackBrush" Color="#D9D9D9" />
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- 追隨陰影：模擬滑塊後方的陰影拖曳 -->
                                                    <Border x:Name="ShadowTrail" Margin="0" CornerRadius="22" Opacity="0.0" IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#55000000" Offset="0.0" />
                                                                <GradientStop Color="#00000000" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- 滑塊 -->
                                                    <Border x:Name="Knob" MinWidth="120" Height="40" Margin="1" CornerRadius="18" Background="White" VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.25" />
                                                        </Border.Effect>
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="KnobTransform" />
                                                        </Border.RenderTransform>

                                                        <!-- 滑塊內容：圖示 + 文字 -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,1" >
                                                            <TextBlock x:Name="IconText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Text="🚫" Foreground="Black" />
                                                            <TextBlock x:Name="LabelText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="{DynamicResource MachineMainDetail_Toggle_Disabled}" Foreground="Black" />
                                                        </StackPanel>
                                                    </Border>

                                                    
                                                </Grid>

                                                <!-- 狀態切換（圖示/文字/前景） -->
                                                <ControlTemplate.Triggers>

                                                    <!-- 禁用（IsChecked=False） -->
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter TargetName="Knob" Property="Background" Value="White" />
                                                        <Setter TargetName="IconText" Property="Text" Value="🚫" />
                                                        <Setter TargetName="IconText" Property="Foreground" Value="#555555" />
                                                        <Setter TargetName="LabelText" Property="Text" Value="{DynamicResource MachineMainDetail_Toggle_Disabled}" />
                                                        <Setter TargetName="LabelText" Property="Foreground" Value="#555555" />
                                                        <!-- 陰影方向（靠滑塊右側） -->
                                                        <Setter TargetName="ShadowTrail" Property="HorizontalAlignment" Value="Right" />
                                                        <Setter TargetName="ShadowTrail" Property="Width" Value="90" />
                                                    </Trigger>

                                                    <!-- 啟用（IsChecked=True） -->
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Knob" Property="Background" Value="#555555" />
                                                        <Setter TargetName="IconText" Property="Text" Value="✓ " />
                                                        <Setter TargetName="IconText" Property="Foreground" Value="White" />
                                                        <Setter TargetName="LabelText" Property="Text" Value="{DynamicResource MachineMainDetail_Toggle_Enabled}" />
                                                        <Setter TargetName="LabelText" Property="Foreground" Value="White" />
                                                        <!-- 陰影方向（靠滑塊左側） -->
                                                        <Setter TargetName="ShadowTrail" Property="HorizontalAlignment" Value="Left" />
                                                        <Setter TargetName="ShadowTrail" Property="Width" Value="90" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 🔸 下方內容區 -->
            <Grid Grid.Row="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="550" />
                </Grid.ColumnDefinitions>
                <!-- 🔹 左邊區塊 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="303" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 🔹 左上區塊 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="227" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 🔹 左上圖片 -->
                        <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="8" BorderBrush="LightGray" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                            </Border.Effect>
                            <Image Source="{Binding MachineImagePath}" Margin="10" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" d:Source="pack://application:,,,/FMSFrontend;component/Image/MachineIcons/EDM.png" />
                        </Border>
                        <!-- 機台資訊區 -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" Margin="8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                            </Border.Effect>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <!-- 區塊標題 -->
                                    <RowDefinition Height="32" />
                                    <!-- Tabs -->
                                    <RowDefinition Height="*" />
                                    <!-- 內容 -->
                                </Grid.RowDefinitions>

                                <!-- 區塊標題 -->
                                <Border Background="#444" CornerRadius="6,6,0,0" VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding SectionMachineInfoTitle}" FontSize="24" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>

                                <TabControl x:Name="MachineInfoTabControl" Grid.Row="1" Style="{StaticResource MachineMainDetailTabControlStyle}" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="TabItem" BasedOn="{StaticResource MachineMainDetailTabItemStyle}">
                                            <Setter Property="Tag" Value="{Binding TagColor}" />
                                            <Setter Property="Header" Value="{Binding Header}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Height" Value="32" />
                                            <Setter Property="FontSize" Value="24" />
                                        </Style>
                                    </TabControl.ItemContainerStyle>
                                </TabControl>
                                <!-- 資訊內容 -->
                                <ContentControl Grid.Row="2" Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Grid Margin="5,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <!-- 標籤 -->
                                                                        <ColumnDefinition Width="3*" />
                                                                        <!-- 資料 -->
                                                                        <ColumnDefinition Width="2*" />
                                                                        <!-- 標籤 -->
                                                                        <ColumnDefinition Width="3*" />
                                                                        <!-- 資料 -->
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>

                                                                    <!-- 左欄標題 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayData.MachineInfos[0].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DisplayData.MachineInfos[1].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DisplayData.MachineInfos[2].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding DisplayData.MachineInfos[3].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 左欄資料 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayData.MachineInfos[0].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayData.MachineInfos[1].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayData.MachineInfos[2].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayData.MachineInfos[3].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 右欄標題 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DisplayData.MachineInfos[4].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DisplayData.MachineInfos[5].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DisplayData.MachineInfos[6].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DisplayData.MachineInfos[7].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 右欄資料 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DisplayData.MachineInfos[4].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DisplayData.MachineInfos[5].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DisplayData.MachineInfos[6].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DisplayData.MachineInfos[7].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                               <Grid Margin="5,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <!-- 標籤 -->
                                                                        <ColumnDefinition Width="3*" />
                                                                        <!-- 資料 -->
                                                                        <ColumnDefinition Width="2*" />
                                                                        <!-- 標籤 -->
                                                                        <ColumnDefinition Width="3*" />
                                                                        <!-- 資料 -->
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>

                                                                    <!-- 左側標籤 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayData.MachineInfos[8].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DisplayData.MachineInfos[9].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DisplayData.MachineInfos[10].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding DisplayData.MachineInfos[11].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 右側資料 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayData.MachineInfos[8].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayData.MachineInfos[9].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayData.MachineInfos[10].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayData.MachineInfos[11].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                  
                                                                    <!-- 右欄標題 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DisplayData.MachineInfos[12].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DisplayData.MachineInfos[13].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DisplayData.MachineInfos[14].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DisplayData.MachineInfos[15].Name}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 右欄資料 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DisplayData.MachineInfos[12].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DisplayData.MachineInfos[13].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DisplayData.MachineInfos[14].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DisplayData.MachineInfos[15].Value}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>

                                                <!-- 可再加其他 Tab Index -->
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                            </Grid>
                        </Border>

                    </Grid>
                    <!-- 🔹 左下區塊 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="444" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 🟦 工作座標區塊 -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" Margin="8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <!-- 標題 -->
                                    <RowDefinition Height="32" />
                                    <!-- Tabs -->
                                    <RowDefinition Height="*" />
                                    <!-- 內容 -->
                                </Grid.RowDefinitions>

                                <!-- 標題 -->
                                <Border Background="#444" CornerRadius="6,6,0,0">
                                    <TextBlock Text="{Binding SectionWorkPositionTitle}" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>

                                <!-- TabControl：資料綁定 -->
                                <TabControl Grid.Row="1" x:Name="WorkPositionTabControl" Style="{StaticResource MachineMainDetailTabControlStyle}" ItemsSource="{Binding TabsPosition}" SelectedIndex="{Binding SelectedTabIndexPosition, Mode=TwoWay}">
                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="TabItem" BasedOn="{StaticResource MachineMainDetailTabItemStyle}">
                                            <Setter Property="Tag" Value="{Binding TagColor}" />
                                            <Setter Property="Header" Value="{Binding Header}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Height" Value="32" />
                                            <Setter Property="FontSize" Value="24" />
                                        </Style>
                                    </TabControl.ItemContainerStyle>
                                </TabControl>

                                <!-- 切換內容區 -->
                                <ContentControl Grid.Row="2" Grid.RowSpan="2" Content="{Binding}" Margin="6">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>

                                                <!-- Tab 0：絕對座標 -->
                                                <DataTrigger Binding="{Binding SelectedTabIndexPosition}" Value="0">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>

                                                                    <!-- 坐標系統 -->
                                                                    <StackPanel  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding PositionLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                        <TextBlock Text="{Binding DisplayData.Position}" FontSize="20" FontWeight="Bold" Margin="20,0,0,0" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <!--以下座標-->
                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding XLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayData.ABS_X}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    
                                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding YLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayData.ABS_Y}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />

                                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ZLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayData.ABS_Z}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />

                                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource MachineMainDetail_Label_W}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DisplayData.ABS_W}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />

                                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DisplayData.ABS_C}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                           
                                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ALabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DisplayData.ABS_A}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    
                                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DisplayData.ABS_B}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>

                                                <!-- Tab 1：機械座標 -->
                                                <DataTrigger Binding="{Binding SelectedTabIndexPosition}" Value="1">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <!-- 範例內容，請依照實際欄位名稱自行修改 -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>

                                                                    <!-- 左欄標題 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding XLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding YLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ZLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 左欄資料 -->
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayData.MCH_X}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayData.MCH_Y}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayData.MCH_Z}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    
                                                                    <!-- 右欄標題 -->
                                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ALabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BLabel}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 右欄資料 -->
                                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DisplayData.MCH_C}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DisplayData.MCH_A}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DisplayData.MCH_B}" FontSize="20" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />

                                                                    <!-- 右欄（可擴充） -->
                                                                    <!-- 可加更多 XYZ 或機械座標值 -->
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                            </Grid>
                        </Border>

                        <!-- 🟦 加工參數 -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" Margin="8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <!-- 標題 -->
                                    <RowDefinition Height="32" />
                                    <!-- Tabs -->
                                    <RowDefinition Height="*" />
                                    <!-- 內容 -->
                                </Grid.RowDefinitions>

                                <!-- 標題列 -->
                                <Border Background="#444" CornerRadius="6,6,0,0" VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding SectionMachiningParamsTitle}" Foreground="White" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>

                                <!-- TabControl -->
                                <TabControl Grid.Row="1" x:Name="MachiningParamTabControl" Style="{StaticResource MachineMainDetailTabControlStyle}" ItemsSource="{Binding TabsParameter}" SelectedIndex="{Binding SelectedTabIndexParameter, Mode=TwoWay}">
                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="TabItem" BasedOn="{StaticResource MachineMainDetailTabItemStyle}">
                                            <Setter Property="Tag" Value="{Binding TagColor}" />
                                            <Setter Property="Header" Value="{Binding Header}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Height" Value="32" />
                                            <Setter Property="FontSize" Value="24" />
                                        </Style>
                                    </TabControl.ItemContainerStyle>
                                </TabControl>

                                <!-- 切換內容區 -->
                                <ContentControl Grid.Row="2" Grid.RowSpan="2" Content="{Binding}" Margin="6">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>

                                                <!-- ✅ Tab 0：加工參數 第1頁 -->
                                                <DataTrigger Binding="{Binding SelectedTabIndexParameter}" Value="0">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="2*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>

                                                                    <!-- 左欄標題 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayData.ProcessingParam[0].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DisplayData.ProcessingParam[1].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DisplayData.ProcessingParam[2].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding DisplayData.ProcessingParam[3].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 左欄資料 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayData.ProcessingParam[0].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayData.ProcessingParam[1].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayData.ProcessingParam[2].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayData.ProcessingParam[3].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />

                                                                    <!-- 右欄標題 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DisplayData.ProcessingParam[4].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DisplayData.ProcessingParam[5].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DisplayData.ProcessingParam[6].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DisplayData.ProcessingParam[7].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 右欄資料 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DisplayData.ProcessingParam[4].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DisplayData.ProcessingParam[5].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DisplayData.ProcessingParam[6].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DisplayData.ProcessingParam[7].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />

                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>

                                                <!-- ✅ Tab 1：加工參數 第2頁 -->
                                                <DataTrigger Binding="{Binding SelectedTabIndexParameter}" Value="1">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="3*" />
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>

                                                                    <!-- 左欄標題 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayData.ProcessingParam[8].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DisplayData.ProcessingParam[9].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DisplayData.ProcessingParam[10].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding DisplayData.ProcessingParam[11].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />

                                                                    <!-- 左欄資料 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayData.ProcessingParam[8].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayData.ProcessingParam[9].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayData.ProcessingParam[10].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayData.ProcessingParam[11].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />

                                                                    <!-- 右欄標題 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DisplayData.ProcessingParam[12].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DisplayData.ProcessingParam[13].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DisplayData.ProcessingParam[14].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DisplayData.ProcessingParam[15].Name}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" />
                                                                    
                                                                    <!-- 右欄資料 -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DisplayData.ProcessingParam[12].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DisplayData.ProcessingParam[13].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DisplayData.ProcessingParam[14].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DisplayData.ProcessingParam[15].Value}" FontSize="18" FontWeight="Bold" FontFamily="微軟正黑體" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                            </Grid>
                        </Border>

                    </Grid>

                </Grid>

                <!-- 🔹 右邊區塊 -->
                <Grid Grid.Column="1" Margin="8">
                    <Border Background="White" CornerRadius="10" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <!-- Tabs -->
                                <RowDefinition Height="*" />
                                <!-- Content -->
                            </Grid.RowDefinitions>

                            <!-- TabControl 區塊 -->

                            <TabControl x:Name="WorkOrderTabControl" Grid.Row="0" Style="{StaticResource MachineMainDetailTabControlStyle}" ItemsSource="{Binding TabsWorkOrder}" SelectedIndex="{Binding SelectedTabIndexWorkOrder, Mode=TwoWay}">
                                <TabControl.ItemContainerStyle>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource MachineMainDetailTabItemStyle}">
                                        <Setter Property="Tag" Value="{Binding TagColor}" />
                                        <Setter Property="Header" Value="{Binding Header}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Height" Value="40" />
                                        <Setter Property="FontSize" Value="24" />
                                    </Style>
                                </TabControl.ItemContainerStyle>
                            </TabControl>

                            <!-- 內容顯示區 -->
                            <ContentControl Grid.Row="1" Content="{Binding}" BorderThickness="0.3" BorderBrush="Black">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <!-- 工單資訊頁 -->
                                            <DataTrigger Binding="{Binding SelectedTabIndexWorkOrder}" Value="0">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <!-- 頁籤1內容，尚未實作 -->
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <!-- 工單列表頁 -->
                                            <DataTrigger Binding="{Binding SelectedTabIndexWorkOrder}" Value="1">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <!-- 頁籤2內容，尚未實作 -->
                                                            <Grid Background="#F5F5F5">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <!-- 篩選選項 -->
                                                                    <RowDefinition Height="*" />
                                                                    <!-- 表格列表 -->
                                                                </Grid.RowDefinitions>

                                                                <!-- 🔹 篩選區塊 -->
                                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,10,0,0" VerticalAlignment="Center">
                                                                    <DockPanel LastChildFill="True" Margin="0,0,0,0" VerticalAlignment="Center">
                                                                        <ComboBox Width="140" Height="32" Margin="3,0,0,0" SelectedIndex="{Binding SelectedFilterIndex}" Style="{StaticResource PillComboBoxStyle}">
                                                                            <ComboBoxItem Content="{DynamicResource MachineMainDetail_DateFilter_Today}" />
                                                                            <ComboBoxItem Content="{DynamicResource MachineMainDetail_DateFilter_Last7Days}" />
                                                                            <ComboBoxItem Content="{DynamicResource MachineMainDetail_DateFilter_Custom}" />
                                                                        </ComboBox>
                                                                        <!-- 僅在 IsCustomDateMode = true 時顯示 -->
                                                                        <StackPanel Orientation="Horizontal"
                                                                            Visibility="{Binding IsCustomDateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <DatePicker Width="160" Height="32" Margin="8,0,0,0"
                                                                             SelectedDate="{Binding FromDate}"
                                                                             IsEnabled="{Binding IsCustomDateMode}"
                                                                             Style="{StaticResource CustomDatePickerStyle}" />
                                                                            <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" VerticalAlignment="Center" Margin="6,0,6,0" />
                                                                            <DatePicker Width="160" Height="32"
                                                                             SelectedDate="{Binding ToDate}"
                                                                             IsEnabled="{Binding IsCustomDateMode}"
                                                                             Style="{StaticResource CustomDatePickerStyle}" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </StackPanel>
                                                                <!-- 🔹 表格列表區 -->
                                                                <DataGrid Grid.Row="1" ItemsSource="{Binding WorkOrders}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" FontSize="16" RowHeight="40" GridLinesVisibility="Horizontal" Margin="8" BorderThickness="1" BorderBrush="#DDD"
                                                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True">

                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="{DynamicResource MachineMainDetail_Column_CreateTime}" Binding="{Binding CreatTime}" Width="SizeToCells"  MinWidth="100"/>
                                                                        <DataGridTextColumn Header="{DynamicResource MachineMainDetail_Column_WorksheetNumber}" Binding="{Binding WorksheetNumber}" Width="SizeToCells" MinWidth="125"/>
                                                                        <DataGridTextColumn Header="{DynamicResource MachineMainDetail_Column_WorkStatus}" Binding="{Binding WorkStatus}" Width="SizeToCells" MinWidth="125"/>
                                                                        <DataGridTextColumn Header="{DynamicResource MachineMainDetail_Column_ElectrodeName}" Binding="{Binding EoectrodeName}" Width="SizeToCells" MinWidth="125"/>
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

        </Grid>
    </Border>
</UserControl>
