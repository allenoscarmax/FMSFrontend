<UserControl x:Class="FMSFrontend.Controls.MachineDetailCardControl" 
             xmlns:ctrl="clr-namespace:FMSFrontend.Controls" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:FMSFrontend.Controls" xmlns:conv="clr-namespace:FMSFrontend.Converters" mc:Ignorable="d" Width="248" Height="300">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <conv:MachineTypeToImageConverter x:Key="MachineTypeToImageConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- 陰影層 -->
        <Border Background="#CCCCCC" CornerRadius="25" Margin="-1" />
        <Border Background="#DDDDDD" CornerRadius="25" SnapsToDevicePixels="True" ClipToBounds="True">
            <Border.Clip>
                <RectangleGeometry RadiusX="25" RadiusY="25" Rect="0,0,248,300" />
            </Border.Clip>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <!-- 工件 / 電極 按鈕 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button FontSize="14" FontWeight="SemiBold" Width="112" Margin="4,0" Background="#CCCCCC" BorderBrush="#CCCCCC" Foreground="#555" Command="{Binding ShowWorkpieceDetailCommand}">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run Text="{Binding WorkpieceName}" />
                                <LineBreak />
                                <Run Text="{Binding ElectrodeName}" />
                            </TextBlock>
                        </Button.ToolTip>
                        <TextBlock Text="{Binding WorkpieceShortName}" />
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button FontSize="14" FontWeight="SemiBold" Width="112" Margin="4,0" Padding="4,2" Background="#CCCCCC" BorderBrush="#CCCCCC" Foreground="#555" Command="{Binding ShowElectrodeDetailCommand}">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run Text="{Binding WorkpieceName}" />
                                <LineBreak />
                                <Run Text="{Binding ElectrodeName}" />
                            </TextBlock>
                        </Button.ToolTip>
                        <TextBlock Text="{Binding ElectrodeShortName}" />
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- 機台名稱 -->
                <TextBlock Grid.Row="1" Text="{Binding MachineName, FallbackValue=name}" Margin="0,10,0,0" FontSize="28" FontWeight="Bold" Foreground="#111" HorizontalAlignment="Center" VerticalAlignment="Top" />
                
                <!-- 機台圖與名稱 -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Center">
                    <Button Grid.Column="0" 
                            Style="{StaticResource ImageButton}" Command="{Binding DataContext.OpenMachineWindowCommand,
      RelativeSource={RelativeSource AncestorType={x:Type ctrl:MachineDetailControl}}}" 
                            ToolTip="{DynamicResource MachineDetailCard_Tooltip_OpenMachine}" 
                            CommandParameter="{Binding}" Cursor="Hand">
                        <Image d:Source="pack://application:,,,/FMSFrontend;component/Image/MachineIcons/AccuteX.png" Source="{Binding MachineTypeName, Converter={StaticResource MachineTypeToImageConverter}}" Width="140" Height="140" Margin="0,2,0,0" Stretch="Uniform" VerticalAlignment="Top" />
                    </Button>

                    <!--<Image Width="140" Height="140" Source="{Binding MachineTypeName, Converter={StaticResource MachineTypeToImageConverter}}" Stretch="Uniform" d:Source="pack://application:,,,/FMSFrontend;component/Image/MachineIcons/AccuteX.png" />-->
                </StackPanel>

               

                <!-- 狀態條 -->
                <Border Grid.Row="3" Grid.RowSpan="3" Height="20" Width="140" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{Binding StatusBrush}" />

                <!-- 禁用角標 -->
                <Canvas Grid.RowSpan="4" Width="88" Height="78" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding Restriction, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False" Panel.ZIndex="99">
                    <Path Data="M88,0 L88,53 A25,25 0 0 1 63,78 L0,78 Z" Stretch="Fill">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0.0" Color="#CCCCCC" />
                                <GradientStop Offset="1.0" Color="#888888" />
                            </LinearGradientBrush>
                        </Path.Fill>
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="315" Color="Black" Opacity="0.3" />
                        </Path.Effect>
                    </Path>
                    <TextBlock Text="{DynamicResource MachineDetailCard_Label_Disabled}" Foreground="White" FontWeight="Bold" FontSize="14" Canvas.Right="8" Canvas.Bottom="8" />
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>
