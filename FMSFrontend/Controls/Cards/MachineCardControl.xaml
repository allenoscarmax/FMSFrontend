<UserControl x:Class="FMSFrontend.Controls.MachineCardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:FMSFrontend.Converters" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:FMSFrontend.Controls" xmlns:vm="clr-namespace:FMSFrontend.ViewModels" mc:Ignorable="d" Width="248" Height="100" >

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <conv:MachineTypeToImageConverter x:Key="MachineTypeToImageConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    
    
    
    <Grid>
        <!-- 陰影層 -->
        <Border Background="#CCCCCC" CornerRadius="25" Margin="-1,-1,-1,-1" />
        <Border Background="#DDDDDD" CornerRadius="25" SnapsToDevicePixels="True" ClipToBounds="True">
            <!-- 強制裁切為圓角矩形 -->
            <Border.Clip>
                <RectangleGeometry RadiusX="25" RadiusY="25" Rect="0,0,300,130" />
            </Border.Clip>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <!-- 工件／電極 -->
                    <RowDefinition Height="*" />
                    <!-- 機台圖與資訊 -->
                </Grid.RowDefinitions>

                <!-- 🔹 第一列：工件與電極按鈕 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Margin="10,8,10,-8" FontSize="14" Foreground="#555555" FontWeight="SemiBold" Command="{Binding ShowWorkpieceDetailCommand}" Background="#CCCCCC" BorderBrush="#CCCCCC" BorderThickness="1" Padding="1,1" Cursor="Hand">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run Text="{Binding WorkpieceName}" />
                                <LineBreak />
                                <Run Text="{Binding ElectrodeName}" />
                            </TextBlock>
                        </Button.ToolTip>
                        <TextBlock Text="{Binding WorkpieceShortName}" />
                        <Button.Resources>
                            <!-- 套用圓角 -->
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Grid.Column="1" Margin="10,8,10,-8" FontSize="14" Foreground="#555555" FontWeight="SemiBold" Command="{Binding ShowElectrodeDetailCommand}" Background="#CCCCCC" BorderBrush="#CCCCCC" BorderThickness="1" Padding="1,1" Cursor="Hand">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run Text="{Binding WorkpieceName}" />
                                <LineBreak />
                                <Run Text="{Binding ElectrodeName}" />
                            </TextBlock>
                        </Button.ToolTip>
                        <TextBlock Text="{Binding ElectrodeShortName}" />
                        <Button.Resources>
                            <!-- 套用圓角 -->
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>

                </Grid>

                <!-- 🔹 第二列：圖、名稱、狀態條 -->
                <Grid Grid.Row="1" Margin="0,13,0,0" HorizontalAlignment="Center" Cursor="">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- 圖片 -->
                        <ColumnDefinition Width="10" />
                        <!-- 間距 -->
                        <ColumnDefinition Width="*" />
                        <!-- 文字與條 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左側圖片 -->
                    <!--<Image Grid.Column="0" Margin="0,2,0,0" d:Source="pack://application:,,,/FMSFrontend;component/Image/MachineIcons/EDM.png" Source="{Binding MachineTypeName, Converter={StaticResource MachineTypeToImageConverter}}" Width="48" Height="48" Stretch="Uniform" VerticalAlignment="Top" />-->

                    <Button Grid.Column="0" Style="{StaticResource ImageButton}" Command="{Binding DataContext.OpenMachineWindowCommand,
                          RelativeSource={RelativeSource AncestorType={x:Type ctrl:MachineOverviewControl}}}" ToolTip="{DynamicResource MachineCard_Tooltip_OpenMachine}" CommandParameter="{Binding}" Cursor="Hand">
                        <Image d:Source="pack://application:,,,/FMSFrontend;component/Image/MachineIcons/EDM.png" Source="{Binding MachineTypeName, Converter={StaticResource MachineTypeToImageConverter}}" Width="48" Height="48" Margin="0,2,0,0" Stretch="Uniform" VerticalAlignment="Top" />
                    </Button>

                    <!-- 右側文字 + 進度條 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <TextBlock Text="{Binding MachineName, FallbackValue=name}" FontWeight="Bold" FontSize="16" Foreground="#222" HorizontalAlignment="Center" Margin="0,2,0,4" />
                        <Border Height="20" Width="120" CornerRadius="15" Background="{Binding StatusBrush}" />
                    </StackPanel>
                </Grid>


                <!-- ✅ 禁用遮罩斜角，包在內層 Canvas 裡，就會被 CornerRadius 遮住 -->
                <Canvas Grid.RowSpan="2" Width="88" Height="78" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding Restriction, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False" Panel.ZIndex="99">
                    <!-- 背景斜角 + 陰影 -->
                    <Path Data="M88,0 L88,53 A25,25 0 0 1 63,78 L0,78 Z" Stretch="Fill">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0.0" Color="#CCCCCC" />
                                <GradientStop Offset="1.0" Color="#888888" />
                            </LinearGradientBrush>
                        </Path.Fill>
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="315" Color="Black" Opacity="0.3" />
                        </Path.Effect>
                    </Path>

                    <!-- 禁用文字 -->
                    <TextBlock Text="{DynamicResource MachineCard_Label_Disabled}" Foreground="White" FontWeight="Bold" FontSize="14" Canvas.Right="6" Canvas.Bottom="6" />
                </Canvas>

            </Grid>
        </Border>

    </Grid>
</UserControl>