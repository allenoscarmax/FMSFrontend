<UserControl x:Class="FMSFrontend.Controls.GradientTextBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="rootControl">
    <Grid>
        <Border CornerRadius="0" Background="{DynamicResource TitleBrush}"
                Padding="{Binding Padding, ElementName=rootControl}">
            <TextBlock Text="{Binding Text, ElementName=rootControl}"
                       FontSize="{Binding FontSize, ElementName=rootControl}"
                       FontWeight="{Binding FontWeight, ElementName=rootControl}"
                       FontFamily="{Binding FontFamily, ElementName=rootControl}"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       Foreground="White"
                       TextAlignment="Left" Padding="10,0" />
        </Border>
    </Grid>
</UserControl>