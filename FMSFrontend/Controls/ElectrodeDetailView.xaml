<UserControl x:Class="FMSFrontend.Controls.ElectrodeDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignHeight="728" d:DesignWidth="489">

    <UserControl.Resources>
        <!-- 標籤（左欄）樣式：與 WorkpieceDetailView 一致 -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>

        <!-- 冒號（中欄）樣式 -->
        <Style x:Key="ColonText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Text" Value="：" />
        </Style>

        <!-- 值（右欄）樣式 -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,8" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

       
    </UserControl.Resources>

    <Border CornerRadius="12" BorderBrush="#000" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <!-- 標題列 -->
                <RowDefinition Height="6" />
                <!-- 黑色分隔線 -->
                <RowDefinition Height="*" />
                <!-- 內容 -->
                <RowDefinition Height="Auto" />
                <!-- 按鈕列 -->
            </Grid.RowDefinitions>

            <!-- 標題列 -->
            <Border Grid.Row="0" Background="#D3D3D3" CornerRadius="12,12,0,0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="電極資訊" Margin="16,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#111" />
                    <!-- 右上角鎖定膠囊 -->
                    <ToggleButton Style="{StaticResource LockPillButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="鎖定/解除鎖定" IsChecked="{Binding Restriction, Mode=TwoWay, TargetNullValue=False}" />
                </Grid>
            </Border>

            <!-- 黑色粗分隔線 -->
            <Border Grid.Row="1" Background="Black" />

            <!-- 內容：三欄(Label / ： / Value) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="10,6,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <!-- Label -->
                        <ColumnDefinition Width="18" />
                        <!-- ： -->
                        <ColumnDefinition Width="*" />
                        <!-- Value -->
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- 被加工次數 -->
                    </Grid.RowDefinitions>

                    <!-- 1 治具序號 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="治具序號" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding JigSerial}" />

                    <!-- 2 電極名稱 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極名稱" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding ElectrodeName}" />

                    <!-- 3 電極編號 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極編號" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding ElectrodeNo}" />

                    <!-- 4 電極類型 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極類型" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding ElectrodeType}" />

                    <!-- 5 狀態 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}" Text="狀態" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding Status}" />

                    <!-- 6 電極夾定器標號 -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極夾定器標號" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding HolderNo}" />

                    <!-- 7 Tag序號 -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelText}" Text="Tag序號" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding TagSerial}" />

                    <!-- 8 放電上限次數 -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelText}" Text="放電上限次數" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding MaxDischargeCount}" />

                    <!-- 9 電極使用率 -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極使用率" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding UsageRate}" />

                    <!-- 10 電極補償值 -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極補償值" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding Compensation}" />

                    <!-- 11 被加工次數 -->
                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource LabelText}" Text="被加工次數" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding ProcessedCount}" />
                </Grid>
            </ScrollViewer>

            <!-- 底部按鈕列：可自動換行，顏色比照圖片 -->
            <Border Grid.Row="3" Padding="8,6,8,10" Background="{x:Null}">
                <WrapPanel HorizontalAlignment="Left">
                    <!-- 1 電極再使用（綠） -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Background="#4CAF50" Content="電極再使用" Command="{Binding ReuseElectrodeCommand}" />

                    <!-- 2 電極再使用（藍）※ 若你有第二種再使用情境，可換文案；否則可移除 -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Background="#1976D2" Content="電極再使用" Command="{Binding ReuseElectrodeAltCommand}" />

                    <!-- 3 修改補償值（紫） -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Background="#9C27B0" Content="修改補償值" Command="{Binding EditCompensationCommand}" />

                    <!-- 4 解除異常（橘） -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Background="#FF9800" Content="解除異常" Command="{Binding ClearAbnormalCommand}" />

                    <!-- 5 解除碰撞（青藍） -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Background="#2196F3" Content="解除碰撞" Command="{Binding ClearCollisionCommand}" />

                    <!-- 6 解除預約（藍綠） -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Background="#00ACC1" Content="解除預約" Command="{Binding ClearReservationCommand}" />
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
