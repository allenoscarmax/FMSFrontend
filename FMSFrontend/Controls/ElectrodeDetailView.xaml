<UserControl x:Class="FMSFrontend.Controls.ElectrodeDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignHeight="728" d:DesignWidth="489">

    <UserControl.Resources>
        <!-- 標籤（左欄）樣式：與 WorkpieceDetailView 一致 -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>

        <!-- 冒號（中欄）樣式 -->
        <Style x:Key="ColonText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Text" Value="：" />
        </Style>

        <!-- 值（右欄）樣式 -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,8" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>


    </UserControl.Resources>

    <Border CornerRadius="12" BorderBrush="#000" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <!-- 標題列 -->
                <RowDefinition Height="6" />
                <!-- 黑色分隔線 -->
                <RowDefinition Height="*" />
                <!-- 內容 -->
                <RowDefinition Height="Auto" />
                <!-- 按鈕列 -->
            </Grid.RowDefinitions>

            <!-- 標題列 -->
            <Border Grid.Row="0" Background="#D3D3D3" CornerRadius="12,12,0,0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="電極資訊" Margin="16,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#111" />
                    <!-- 右上角鎖定膠囊 -->
                    <ToggleButton Name ="ElecRestriction" Command="{Binding DataContext.UpdataElectrodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"  Style="{StaticResource LockPillButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="鎖定/解除鎖定" IsChecked="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 黑色粗分隔線 -->
            <Border Grid.Row="1" Background="Black" />

            <!-- 內容：三欄(Label / ： / Value) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="10,6,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <!-- Label -->
                        <ColumnDefinition Width="18" />
                        <!-- ： -->
                        <ColumnDefinition Width="*" />
                        <!-- Value -->
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <RowDefinition Height="37" />
                        <!-- 被加工次數 -->
                    </Grid.RowDefinitions>

                    <!-- 1 電極名稱 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極名稱" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding ElectrodeName}" />

                    <!-- 2 電極編號 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極編號" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding ElectrodeNo}" />

                    <!-- 3 電極類型 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極類型" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding ElectrodeType}" />

                    <!-- 4 狀態 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}" Text="狀態" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding Status}" />

                    <!-- 5 Tag序號 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}" Text="Tag序號" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding TagSerial}" />

                    <!-- 6 放電上限次數 -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}" Text="放電上限次數" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding MaxDischargeCount}" />

                    <!-- 7 電極使用率 -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極使用率" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding UsageRate}" />

                    <!-- 8 電極補償值 -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelText}" Text="電極補償值" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding Compensation}" />

                    <!-- 9 被加工次數 -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelText}" Text="被加工次數" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding ProcessedCount}" />
                </Grid>
            </ScrollViewer>

            <!-- 底部按鈕列：兩排排列，顏色比照圖片 -->
            <Border Grid.Row="3" Padding="8,1,8,10" Background="{x:Null}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                    <!-- 第一排：4 個按鈕 -->
                    <WrapPanel Margin="0,0,0,8">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#2F64CF" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="電極再使用" Command="{Binding ReuseElectrodeCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#C0392B" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="解除異常" Command="{Binding ClearAbnormalCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#9C27B0" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="修改補償值" Command="{Binding EditCompensationCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#56C06C" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="電極再使用" Command="{Binding ReuseElectrodeAltCommand}" />
                    </WrapPanel>

                    <!-- 第二排：3 個按鈕 -->
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#6E6E6E" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="解除碰撞" Command="{Binding ClearCollisionCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#E6B93E" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="解除預約" Command="{Binding ClearReservationCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#000000" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="電極補償值" Command="{Binding EditCompensationCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
