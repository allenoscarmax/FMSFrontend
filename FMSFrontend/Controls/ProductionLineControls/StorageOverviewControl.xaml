<UserControl x:Class="FMSFrontend.Controls.StorageOverviewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:FMSFrontend.Controls" xmlns:conv="clr-namespace:FMSFrontend.Converters" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:vm="clr-namespace:FMSFrontend.ViewModels.Production" mc:Ignorable="d" d:DesignHeight="724" d:DesignWidth="899" x:Name="root" Background="Transparent">

    <UserControl.Resources>
        <conv:StorageTypeToBrushConverter x:Key="StorageTypeToBrushConverter" />
    </UserControl.Resources>
    <Grid>
        <!-- 外層圓角白底 + 陰影 -->
        <Border CornerRadius="18" Background="#FFFFFF" Margin="0" BorderBrush="#DDD"  ClipToBounds="True" SnapsToDevicePixels="True">
            <!-- 用 Grid 分區塊＋裁切 -->
            <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 標題 -->
                    <RowDefinition Height="Auto" />
                    <!-- 狀態條 -->
                    <RowDefinition Height="*" />
                    <!-- 倉儲區塊 -->
                </Grid.RowDefinitions>

                <!-- ✅ 標題列 -->
                <Border Grid.Row="0" CornerRadius="18,18,0,0" Background="#EEEEEE" SnapsToDevicePixels="True" ClipToBounds="True">
                    <Grid Height="40" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource StorageOverviewControl_Title}" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="20,0,0,0" />
                        <Button Grid.Column="1" Width="28" Height="28" Margin="0,0,20,0" HorizontalAlignment="Right" Background="Transparent" BorderBrush="{x:Null}" ToolTip="{DynamicResource StorageOverviewControl_Tooltip_Toggle}" Command="{Binding ToggleExpandCommand}">
                            <materialDesign:PackIcon Kind="ViewGrid" Width="24" Height="24" Foreground="#555" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 狀態統計列 -->
                <Grid Grid.Row="1" FocusVisualStyle="{x:Null}" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Border Background="#E6B93E" CornerRadius="4" Margin="4,0" Padding="4" MinWidth="80" HorizontalAlignment="Center">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Height="25" Text="{DynamicResource StorageOverviewControl_Status_Waiting}" FontSize="16" Foreground="White" Margin="5,0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <Border Width="50" Height="25" Background="White" CornerRadius="15" Margin="5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StorageGroup.WaitingTotal}" d:Text ="12"  Foreground="#222"  FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#56C06C" CornerRadius="4" Margin="4,0" Padding="4" MinWidth="80" HorizontalAlignment="Center">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Height="25" Text="{DynamicResource StorageOverviewControl_Status_Processing}" FontSize="16" Foreground="White" Margin="5,0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <Border Width="50" Height="25" Background="White" CornerRadius="15" Margin="5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StorageGroup.ProcessingTotal}" d:Text="3" Foreground="#222" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#C0392B" CornerRadius="4" Margin="4,0" Padding="4" MinWidth="80" HorizontalAlignment="Center">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Height="25" Text="{DynamicResource StorageOverviewControl_Status_Error}" FontSize="16" Foreground="White" Margin="5,0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <Border Width="50" Height="25" Background="White" CornerRadius="15" Margin="5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StorageGroup.ErrorTotal}" d:Text="4" Foreground="#222" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#2F64CF" CornerRadius="4" Margin="4,0" Padding="4" MinWidth="80" HorizontalAlignment="Center">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Height="25" Text="{DynamicResource StorageOverviewControl_Status_Completed}" FontSize="16" Foreground="White" Margin="5,0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <Border Width="50" Height="25" Background="White" CornerRadius="15" Margin="5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StorageGroup.CompletedTotal}" d:Text="5" Foreground="#222" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="BlueViolet" CornerRadius="4" Margin="4,0" Padding="4" MinWidth="80" HorizontalAlignment="Center">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Height="25" Text="{DynamicResource StorageOverviewControl_Status_Fail}" FontSize="16" Foreground="White" Margin="5,0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <Border Width="50" Height="25" Background="White" CornerRadius="15" Margin="5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StorageGroup.FailTotal}" d:Text="5" Foreground="#222" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#CCCCCC" CornerRadius="4" Margin="4,0" Padding="4" MinWidth="80" HorizontalAlignment="Center">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Height="25" Text="{DynamicResource StorageOverviewControl_Status_Disabled}" FontSize="16" Foreground="#555" Margin="5,0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <Border Width="50" Height="25" Background="White" CornerRadius="15" Margin="5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StorageGroup.RestrictionTotal}" d:Text="8" Foreground="#222" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" CornerRadius="4" Margin="4,0" Padding="4" MinWidth="80" HorizontalAlignment="Center" BorderBrush="#CCCCCC" BorderThickness="1">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Height="25" Text="{DynamicResource StorageOverviewControl_Status_Booked}" FontSize="16" Foreground="#555" Margin="5,0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <Border Width="50" Height="25" Background="#D6D6D6" CornerRadius="15" Margin="5,0" VerticalAlignment="Center" >
                                    <TextBlock Text="{Binding StorageGroup.BookedTotal}" d:Text="9" Foreground="#222" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 多倉位區塊（針對某個 StorageUnit 顯示）-->
                <Border Grid.Row="2" CornerRadius="18" Background="#FFFFFF" SnapsToDevicePixels="True" ClipToBounds="True" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding StorageGroup.Storage}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="260" Margin="10" Padding="10" Background="White" CornerRadius="12" BorderBrush="#CCC" BorderThickness="1" SnapsToDevicePixels="True">
                                        <StackPanel>
                                            <!-- 倉儲名稱 -->
                                            <Border Background="{Binding KindBrush}" CornerRadius="6" Height="28" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0" />
                                            </Border>

                                            <!-- 倉儲格子 -->
                                            <ItemsControl ItemsSource="{Binding Slots}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>


                                                <ItemsControl.ItemTemplate>

                                                    <!-- 假設每格是 SlotViewModel -->
                                                    <DataTemplate>
                                                        <!-- 無樣式 Button 包住原本的 Border -->
                                                        <Button Command="{Binding DataContext.OpenMaterialCommand, ElementName=root}" CommandParameter="{Binding}" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand" Focusable="False">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <!-- 你原本的格子外觀 -->
                                                                    <Border Width="22" Height="22" Margin="2" Background="{Binding StatusBrush}" CornerRadius="4" BorderBrush="#DDD" BorderThickness="0.5" />
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>

                                                    <!--<DataTemplate>
														<Border Width="22" Height="22" Margin="2" Background="{Binding Background}" CornerRadius="4" BorderBrush="#DDD" BorderThickness="0.5" />
													</DataTemplate>-->
                                                </ItemsControl.ItemTemplate>


                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

            </Grid>

        </Border>
    </Grid>
</UserControl>
