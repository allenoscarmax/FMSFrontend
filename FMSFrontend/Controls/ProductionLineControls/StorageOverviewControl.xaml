<UserControl x:Class="FMSFrontend.Controls.StorageOverviewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:FMSFrontend.Controls" xmlns:conv="clr-namespace:FMSFrontend.Converters" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:vm="clr-namespace:FMSFrontend.ViewModels.Production" mc:Ignorable="d" d:DesignHeight="724" d:DesignWidth="899" x:Name="root" Background="Transparent">

	<UserControl.Resources>
		<conv:StorageTypeToBrushConverter x:Key="StorageTypeToBrushConverter" />
	</UserControl.Resources>
	<Grid>
		<!-- 陰影層 -->
		<Border Background="#33000000" CornerRadius="18" Margin="-2,-2,-2,-2"/>

		<!-- 外層圓角白底 + 陰影 -->
		<Border CornerRadius="18" Background="#FFFFFF" BorderBrush="#DDD"  ClipToBounds="True" SnapsToDevicePixels="True">
			<!-- 用 Grid 分區塊＋裁切 -->
			<Grid ClipToBounds="True" SnapsToDevicePixels="True">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<!-- 標題 -->
					<RowDefinition Height="Auto" />
					<!-- 狀態條 -->
					<RowDefinition Height="*" />
					<!-- 倉儲區塊 -->
				</Grid.RowDefinitions>

				<!-- ✅ 標題列 -->
				<Border Grid.Row="0" CornerRadius="18,18,0,0" Background="#EEEEEE" SnapsToDevicePixels="True" ClipToBounds="True">
					<Grid Height="40" Margin="0,0,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="Storage Overview" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="20,0,0,0" />
						<Button Grid.Column="1" Width="28" Height="28" Margin="0,0,20,0" HorizontalAlignment="Right" Background="Transparent" BorderBrush="{x:Null}" ToolTip="展開/收合倉儲" Command="{Binding ToggleExpandCommand}">
							<materialDesign:PackIcon Kind="ViewGrid" Width="24" Height="24" Foreground="#555" />
						</Button>
					</Grid>
				</Border>

				<!-- 狀態統計列 -->
				<Grid Grid.Row="1" FocusVisualStyle="{x:Null}" HorizontalAlignment="Center" Margin="0,20,0,10">
					<StackPanel Orientation="Horizontal" Margin="8,0,0,0">
						<Border Background="#F3B407" CornerRadius="4" Margin="0,0,8,0" Height="24" Width="88" HorizontalAlignment="Center">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
								<TextBlock Text="待加工" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
								<Border Width="20" Height="16" Background="White" CornerRadius="8" Margin="6,0,0,0" VerticalAlignment="Center">
									<TextBlock Text="{Binding VerifiedCount}" d:Text ="12"  Foreground="#222"  FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
								</Border>
							</StackPanel>
						</Border>
						<Border Background="#1DB945" CornerRadius="4" Margin="0,0,8,0" Height="24" Width="80" HorizontalAlignment="Center">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
								<TextBlock Text="加工中" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
								<Border Width="20" Height="16" Background="White" CornerRadius="8" Margin="6,0,0,0" VerticalAlignment="Center">
									<TextBlock Text="{Binding ProcessingCount}" d:Text="3" Foreground="#222" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
								</Border>
							</StackPanel>
						</Border>
						<Border Background="#CF1916" CornerRadius="4" Margin="0,0,8,0" Height="24" Width="80" HorizontalAlignment="Center">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
								<TextBlock Text="異常" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
								<Border Width="20" Height="16" Background="White" CornerRadius="8" Margin="6,0,0,0" VerticalAlignment="Center">
									<TextBlock Text="{Binding ErrorCount}" d:Text="4" Foreground="#222" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
								</Border>
							</StackPanel>
						</Border>
						<Border Background="#0877E3" CornerRadius="4" Margin="0,0,8,0" Height="24" Width="80" HorizontalAlignment="Center">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
								<TextBlock Text="完成" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
								<Border Width="20" Height="16" Background="White" CornerRadius="8" Margin="6,0,0,0" VerticalAlignment="Center">
									<TextBlock Text="{Binding CompletedCount}" d:Text="5" Foreground="#222" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
								</Border>
							</StackPanel>
						</Border>
						<Border Background="#CCCCCC" CornerRadius="4" Margin="0,0,8,0" Height="24" Width="80" HorizontalAlignment="Center">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
								<TextBlock Text="禁用" Foreground="#555" FontWeight="Bold" VerticalAlignment="Center" />
								<Border Width="20" Height="16" Background="White" CornerRadius="8" Margin="6,0,0,0" VerticalAlignment="Center">
									<TextBlock Text="{Binding RestrictionCount}" d:Text="8" Foreground="#222" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
								</Border>
							</StackPanel>
						</Border>
						<Border Background="White" CornerRadius="4" Margin="0,0,8,0" BorderBrush="#CCCCCC" BorderThickness="1" Height="24" Width="80" HorizontalAlignment="Center">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
								<TextBlock Text="預約" Foreground="#555" FontWeight="Bold" VerticalAlignment="Center"  />
								<Border Width="20" Height="16" Background="#D6D6D6" CornerRadius="8" Margin="12,0,0,0" VerticalAlignment="Center" >
									<TextBlock Text="{Binding BookedCount}" d:Text="9" Foreground="#222" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
								</Border>
							</StackPanel>
						</Border>
					</StackPanel>
				</Grid>

				<!-- 多倉位區塊（針對某個 StorageUnit 顯示）-->
				<Border Grid.Row="2" CornerRadius="12" Background="#FFFFFF" SnapsToDevicePixels="True" ClipToBounds="True" Padding="8">
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center">
						<ItemsControl ItemsSource="{Binding StorageUnits}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>

							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Width="260" Margin="10" Padding="10" Background="White" CornerRadius="12" BorderBrush="#CCC" BorderThickness="1" SnapsToDevicePixels="True">
										<StackPanel>
											<!-- 倉儲名稱 -->
											<Border Background="{Binding HeaderColor}" CornerRadius="6" Height="28" Margin="0,0,0,10">
												<TextBlock Text="{Binding StorageName}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0" />
											</Border>

											<!-- 倉儲格子 -->
											<ItemsControl ItemsSource="{Binding Slots}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
                                                
                                                
												<ItemsControl.ItemTemplate>

                                                    <!-- 假設每格是 SlotViewModel -->
                                                    <DataTemplate>
                                                        <!-- 無樣式 Button 包住原本的 Border -->
                                                        <Button Command="{Binding DataContext.OpenMaterialCommand, ElementName=root}" CommandParameter="{Binding}" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand" Focusable="False">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <!-- 你原本的格子外觀 -->
                                                                    <Border Width="22" Height="22" Margin="2" Background="{Binding Background}" CornerRadius="4" BorderBrush="#DDD" BorderThickness="0.5" />
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>

                                                    <!--<DataTemplate>
														<Border Width="22" Height="22" Margin="2" Background="{Binding Background}" CornerRadius="4" BorderBrush="#DDD" BorderThickness="0.5" />
													</DataTemplate>-->
												</ItemsControl.ItemTemplate>
                                                
                                                
											</ItemsControl>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>

			</Grid>

		</Border>
	</Grid>
</UserControl>
