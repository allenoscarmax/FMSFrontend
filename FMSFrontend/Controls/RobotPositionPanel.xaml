<UserControl x:Class="FMSFrontend.Controls.RobotPositionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf" xmlns:conv="clr-namespace:FMSFrontend.Converters" mc:Ignorable="d" Height="278.5" Width="388">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />

    </UserControl.Resources>

      <Border Background="Transparent" CornerRadius="10" Padding="8" d:Background="AliceBlue">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding SelectedRobot.Name, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" d:Text="主線 機器人" />

                    <Border Name ="RobotBorderStatus" Grid.Row="1" Height="12" Width="90" CornerRadius="6" Margin="0,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Default when not connected -->
                                <Setter Property="Background" Value="#FF555555" />
                                <Style.Triggers>
                                    <!-- When connected, use SelectedRobot.StatusBrush -->
                                    <DataTrigger Binding="{Binding SelectedRobot.IsRobotConnected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <Binding Path="SelectedRobot.StatusBrush" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="107*" />
                            <ColumnDefinition Width="79*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/FMSFrontend;component/Image/MachineIcons/Robot.png" Height="120" Stretch="Uniform" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="39,30,0,29" />
                        <Path Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Height="135" Data="M91.5895,3.10921 C99.4785,1.53738 107.655,0.569035 115.934,0.229427 L115.946,0.121578 C107.658,-0.190494 99.2773,0.128462 90.9858,1.0968 C89.3514,1.25889 87.7386,1.50155 86.1212,1.7449 C84.7896,1.94353 83.2469,2.18906 81.717,2.47359 L78.6508,3.04496 C76.6779,3.4775 75.6198,3.71271 74.1026,4.05002 L72.5983,4.41487 C70.9746,4.83552 66.6448,6.0303 63.6968,6.90915 C60.8063,7.88438 56.5685,9.41747 54.3929,10.2456 C49.554,12.3039 44.2106,14.8922 37.2286,18.5017 C30.7066,22.6734 25.0629,27.4577 20.9523,31.1292 C18.099,33.9838 14.5165,38.004 11.4983,41.9026 C9.16031,45.4019 6.80831,49.5152 5.50325,52.1023 C3.77533,56.1317 2.05699,61.4323 0.226863,80.8795 C0.804966,87.4376 2.5233,94.021 5.51922,100.345 C7.51269,104.257 10.1172,108.586 13.2166,113.011 C17.752,118.429 22.8495,123.608 36.0341,133.918 C49.9565,143.193 67.2197,150.01 85.7861,153.65 C104.669,156.474 139.364,156.991 174.204,156.772 V162 L203.926,143.214 L174.204,122.628 V129.379 C139.364,129.161 104.749,129.391 85.077,126.795 C64.5621,121.058 44.6609,111.017 30.7668,92.3344 C20.7639,79.1608 17.7073,63.0202 19.333,54.8949 C23.5543,45.0982 33.3895,32.1205 49.2059,19.4448 C61.8539,12.3612 74.3965,7.64803 91.5895,3.10921 Z" Margin="8,27,0,0" RenderTransformOrigin="0.484,0.52" Grid.ColumnSpan="2">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="gradientStop1" Color="#00FFFFFF" Offset="0" />
                                    <GradientStop x:Name="gradientStop2" Color="#005E93" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Path.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="gradientStop1" Storyboard.TargetProperty="Offset" From="-1" To="1.5" Duration="0:0:2" />
                                            <DoubleAnimation Storyboard.TargetName="gradientStop2" Storyboard.TargetProperty="Offset" From="0" To="2.5" Duration="0:0:2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,30,0,8">
                        <md:PackIcon Kind="MapMarker" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#D70011" />
                        <TextBlock Text="{Binding SelectedRobot.CurrentLocation, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="18" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center" d:Text="EDM205" />
                    </StackPanel>

                    <Border Grid.Row="1" BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="0,25,0,20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RobotPositionPanel_Label_CurrentAction}" FontSize="16" Background="Transparent" Padding="0,2" TextAlignment="Left" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding SelectedRobot.CurrentAction, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="14" Background="#444" Foreground="White" Padding="5,2" TextAlignment="Center" d:Text="result" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" BorderThickness="1" BorderBrush="Black" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RobotPositionPanel_Label_NextAction}" FontSize="16" Background="Transparent" Padding="5,2" TextAlignment="Left" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding SelectedRobot.NextAction, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="14" Background="#444" Foreground="White" Padding="5,2" TextAlignment="Center" d:Text="next" RenderTransformOrigin="0.495,4.568" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="0,5,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 按鈕靠左 -->
                <Button Grid.Column="0"
                        Width="60"
                        Height="32"
                        Background="White"
                        BorderBrush="#CCC"
                        Visibility="{Binding SelectedRobot.IsMultipleRobotVisible}"
                        Command="{Binding LastRobotCommand}"
                        HorizontalAlignment="Right"
                        Margin="10,0,0,0" RenderTransformOrigin="0.511,0.557">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <md:PackIcon Kind="ChevronLeft" Width="20" Height="20" />
                </Button>
                
                <!-- 文字置中 -->
                <TextBlock Grid.Column="1" Text="{Binding SelectedRobot.SelectedRobotIndexDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding SelectedRobot.IsMultipleRobotVisible}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" d:Text="1 / 5" />

                <!-- 按鈕靠右 -->
                <Button Grid.Column="2"
                        Width="60"
                        Height="32"
                        Background="White"
                        BorderBrush="#CCC"
                        Visibility="{Binding SelectedRobot.IsMultipleRobotVisible}"
                        Command="{Binding NextRobotCommand}"
                        HorizontalAlignment="Right"
                        Margin="10,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <md:PackIcon Kind="ChevronRight" Width="20" Height="20" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>