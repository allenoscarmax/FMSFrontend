<UserControl x:Class="FMSFrontend.Controls.WorkpieceDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignHeight="577" d:DesignWidth="511">

    <UserControl.Resources>
        <!-- 標籤（左欄）樣式 -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>

        <!-- 冒號（中欄）樣式 -->
        <Style x:Key="ColonText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Text" Value="：" />
        </Style>

        <!-- 值（右欄）樣式 -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,8" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </UserControl.Resources>

    <Border CornerRadius="18" Margin="-1" BorderBrush="#000" BorderThickness="1" Background="White">
        <Grid Cursor="Hand">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <!-- 標題列 -->
                <RowDefinition Height="6" />
                <!-- 黑色分隔線 -->
                <RowDefinition Height="*" />

                <RowDefinition Height="Auto" />
                <!-- 內容 -->
            </Grid.RowDefinitions>

            <!-- 標題列 -->
            <Border Grid.Row="0" Background="#D3D3D3" CornerRadius="18,18,0,0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="工件資訊" Margin="16,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#111" />
                    <!-- 右上角鎖定膠囊 -->
                    <ToggleButton  Name ="WorkRestriction" Command="{Binding DataContext.UpdataWorkpieceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource LockPillButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="鎖定/解除鎖定" IsChecked="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 黑色粗分隔線 -->
            <Border Grid.Row="1" Background="Black" />

            <!-- 內容區（三欄：Label / ： / Value） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,2" Grid.RowSpan="2">
                <Grid Margin="10,6,16,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <!-- Label -->
                        <ColumnDefinition Width="18" />
                        <!-- ： -->
                        <ColumnDefinition Width="*" />

                        <!-- Value -->
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="工件名稱" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding WorkName}" />

                    <!-- 2 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}" Text="工件編號" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding WorkNo}" />

                    <!-- 3 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="工件類型" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding WorkType}" />

                    <!-- 4 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}" Text="零件件號" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding PartNo}" />

                    <!-- 5 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}" Text="工單序號" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding OrderNo}" />

                    <!-- 6 -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}" Text="狀態" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding Status}" />

                    <!-- 7 -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelText}" Text="批號" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource ColonText}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding BatchNo}" />

                </Grid>
            </ScrollViewer>
            <!-- 底部按鈕列：兩排排列，顏色比照圖片 -->
            <Border Grid.Row="3" Padding="8,1,8,10" Background="{x:Null}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                    <WrapPanel Margin="0,0,0,8">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#E58C2C" Foreground="White" Width="120" Height="40" Margin="8,0,8,0" FontSize="14" Content="工件解除預約" Command="{Binding DataContext.WorkpieceClearBookedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <!--<Button Style="{StaticResource PrimaryButtonStyle}" Background="#C0392B" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="解除異常" Command="{Binding ClearAbnormalCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#9C27B0" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="修改補償值" Command="{Binding EditCompensationCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#56C06C" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="電極再使用" Command="{Binding ReuseElectrodeAltCommand}" />-->
                    </WrapPanel>
                    <!--<WrapPanel>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#2F64CF" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="電極再使用" Command="{Binding ReuseElectrodeCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#6E6E6E" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="解除碰撞" Command="{Binding ClearCollisionCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Background="#000000" Foreground="White" Width="100" Height="40" Margin="8,0,8,0" FontSize="16" Content="電極補償值" Command="{Binding EditCompensationCommand}" />
                    </WrapPanel>-->
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
