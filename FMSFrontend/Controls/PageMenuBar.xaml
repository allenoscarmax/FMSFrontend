<UserControl x:Class="FMSFrontend.Controls.PageMenuBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:controls="clr-namespace:FMSFrontend.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"   
             mc:Ignorable="d" d:DesignHeight="100" d:DesignWidth="1920">
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>

        <UniformGrid Columns="8" Grid.Column="0">
            <!--<controls:PageMenuItem Icon="ChartPie" Label="設備稼動" Command="{Binding GoToEquipmentStatusCommand}" />-->
            <!--<controls:PageMenuItem Icon="ChartBox" Label="倉儲稼動" Command="{Binding GoToWarehouseStatusCommand}" />-->
            <!--<controls:PageMenuItem Icon="ViewGrid" Label="庫存資訊" Command="{Binding GoToInventoryCommand}" />-->
            <controls:PageMenuItem Icon="Factory" Label="整場總覽" Command="{Binding GoToFactoryOverviewCommand}" PageKey="FactoryOverview" CurrentPageKey="{Binding CurrentPageKey}" />

            <controls:PageMenuItem Icon="ViewDashboard" Label="設備總覽" Command="{Binding GoToMachineOverviewCommand}" PageKey="MachineOverview" CurrentPageKey="{Binding CurrentPageKey}" />

            <controls:PageMenuItem Icon="LanConnect" Label="產線總覽" Command="{Binding GoToProductionLinesCommand}" PageKey="ProductionLines" CurrentPageKey="{Binding CurrentPageKey}" />

            <controls:PageMenuItem Icon="ClipboardList" Label="工單派工" Command="{Binding GoToWorkOrderCommand}" PageKey="WorkOrder" CurrentPageKey="{Binding CurrentPageKey}" />

            <controls:PageMenuItem Icon="QrCodeScan" Label="燒錄裝夾" Command="{Binding GoToRFIDBindCommand}" PageKey="RFIDBind" CurrentPageKey="{Binding CurrentPageKey}" />

            <controls:PageMenuItem Icon="History" Label="操作歷程" Command="{Binding GoToOperationHistoryCommand}" PageKey="OperationHistory" CurrentPageKey="{Binding CurrentPageKey}" />

            <controls:PageMenuItem Icon="BookOpenPageVariant" Label="操作手冊" Command="{Binding GoToManualCommand}" PageKey="Manual" CurrentPageKey="{Binding CurrentPageKey}" />

            <controls:PageMenuItem Icon="Cog" Label="設定" Command="{Binding GoToSettingsCommand}" PageKey="Settings" CurrentPageKey="{Binding CurrentPageKey}" />
        </UniformGrid>

        <!-- 展開收合按鈕 -->
        <Button Grid.Column="1" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderBrush="{x:Null}" ToolTip="收合功能表">
            <materialDesign:PackIcon Kind="ChevronDown" Width="24" Height="24" Foreground="White" />
        </Button>
    </Grid>
</UserControl>