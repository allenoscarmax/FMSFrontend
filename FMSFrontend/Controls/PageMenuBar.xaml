<UserControl x:Class="FMSFrontend.Controls.PageMenuBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:controls="clr-namespace:FMSFrontend.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d" d:DesignHeight="100" d:DesignWidth="1920" x:Name="MenuBarRoot" SnapsToDevicePixels="True">
    <Grid Background="Transparent" SnapsToDevicePixels="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>

        <UniformGrid x:Name="MenuItemsContainer" Columns="8" Grid.Column="0" SnapsToDevicePixels="True" Background="Transparent">
            <controls:PageMenuItem Icon="Factory" Label="{DynamicResource PageMenuBar_Label_ProductionLines}" Command="{Binding GoToProductionLinesCommand}" PageKey="ProductionLines" CurrentPageKey="{Binding CurrentPageKey, ElementName=MenuBarRoot}" />
            
            <controls:PageMenuItem Icon="LanConnect" Label="{DynamicResource PageMenuBar_Label_FactoryOverview}" Command="{Binding GoToFactoryOverviewCommand}" PageKey="FactoryOverview" CurrentPageKey="{Binding CurrentPageKey, ElementName=MenuBarRoot}"/>

            <controls:PageMenuItem Icon="ViewDashboard" Label="{DynamicResource PageMenuBar_Label_MachineOverview}" Command="{Binding GoToMachineOverviewCommand}" PageKey="MachineOverview" CurrentPageKey="{Binding CurrentPageKey, ElementName=MenuBarRoot}" />

            <controls:PageMenuItem Icon="ClipboardList" Label="{DynamicResource PageMenuBar_Label_WorkOrder}" Command="{Binding GoToWorkOrderCommand}" PageKey="WorkOrder" CurrentPageKey="{Binding CurrentPageKey, ElementName=MenuBarRoot}" />

            <controls:PageMenuItem Icon="QrCodeScan" Label="{DynamicResource PageMenuBar_Label_RfidBind}" Command="{Binding GoToRFIDBindCommand}" PageKey="RFIDBind" CurrentPageKey="{Binding CurrentPageKey, ElementName=MenuBarRoot}" />

            <controls:PageMenuItem Icon="History" Label="{DynamicResource PageMenuBar_Label_OperationHistory}" Command="{Binding GoToOperationHistoryCommand}" PageKey="OperationHistory" CurrentPageKey="{Binding CurrentPageKey, ElementName=MenuBarRoot}" />

            <controls:PageMenuItem Icon="Storage" Label="{DynamicResource PageMenuBar_Label_Inventory}" Command="{Binding GoToMaterialCommand}" PageKey="Material" CurrentPageKey="{Binding CurrentPageKey, ElementName=MenuBarRoot}" />

            <controls:PageMenuItem Icon="Cog" Label="{DynamicResource PageMenuBar_Label_Settings}" Command="{Binding GoToSettingsViewCommand}" PageKey="SettingsView" CurrentPageKey="{Binding CurrentPageKey, ElementName=MenuBarRoot}" />
        </UniformGrid>

        <!-- 展開收合按鈕 -->
        <Button Grid.Column="1" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderBrush="{x:Null}" ToolTip="{DynamicResource PageMenuBar_Tooltip_Collapse}">
            <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24" Foreground="White" />
        </Button>
    </Grid>
</UserControl>