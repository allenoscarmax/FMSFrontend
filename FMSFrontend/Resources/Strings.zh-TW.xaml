<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Settings_Title">系統設定</sys:String>

    <sys:String x:Key="Settings_Tab_Basic">基本設定</sys:String>
    <sys:String x:Key="Settings_Tab_Advanced">進階設定</sys:String>
    <sys:String x:Key="Settings_Tab_Device">設備設定</sys:String>
    <sys:String x:Key="Settings_Tab_Worker">人員管理</sys:String>
    <sys:String x:Key="Settings_Tab_Maintenance">保養設定</sys:String>

    <sys:String x:Key="Settings_Group_Permission">權限設定</sys:String>
    <sys:String x:Key="Settings_Label_Permission">權限</sys:String>
    <sys:String x:Key="Settings_Label_Password">密碼：</sys:String>
    <sys:String x:Key="Settings_Button_Confirm">確認</sys:String>

    <sys:String x:Key="Settings_Group_KeepLogin">保持登入</sys:String>
    <sys:String x:Key="Settings_Label_KeepLogin">開啟程式時，自動登入上次使用者</sys:String>

    <sys:String x:Key="Settings_Group_Language">語言設定</sys:String>

    <sys:String x:Key="Settings_Group_SystemIp">系統IP位址</sys:String>
    <sys:String x:Key="Settings_Button_Set">設定</sys:String>
    <sys:String x:Key="Settings_Label_IpAddress">IP位址:</sys:String>

    <sys:String x:Key="Settings_Group_SystemRestore">系統還原</sys:String>
    <sys:String x:Key="Settings_Button_Restore">還原</sys:String>
    <sys:String x:Key="Settings_Text_SystemRestoreNote">注意：點擊還原按鈕以還原系統。此過程將刪除所有材料、表單、日誌和使用情況。</sys:String>

    <sys:String x:Key="Settings_Group_SystemBackup">系統備份</sys:String>
    <sys:String x:Key="Settings_Button_Backup">備份</sys:String>
    <sys:String x:Key="Settings_Text_SystemBackupNote">注意：點擊備份資料庫。</sys:String>

    <sys:String x:Key="Settings_Group_RobotMaintenance">機器手臂維護</sys:String>
    <sys:String x:Key="Settings_Button_MaintenanceComplete">維護完成</sys:String>
    <sys:String x:Key="Settings_Text_RobotMaintenanceNote">注意：如果系統顯示機器人的維護警報，請聯繫 FANUC 進行維護。</sys:String>
    <sys:String x:Key="Settings_Label_LastMaintenance">上次維護時間：</sys:String>

    <sys:String x:Key="Settings_Section_Device">設備</sys:String>
    <sys:String x:Key="Settings_Section_DeviceHint">設備的相關設定</sys:String>
    <sys:String x:Key="Settings_SubTab_Machine">機台</sys:String>
    <sys:String x:Key="Settings_SubTab_Robot">機械手臂</sys:String>
    <sys:String x:Key="Settings_SubTab_Device">設備</sys:String>
    <sys:String x:Key="Settings_Tooltip_Edit">編輯</sys:String>

    <sys:String x:Key="Settings_Column_MachineNo">機台編號</sys:String>
    <sys:String x:Key="Settings_Column_MachineName">機台名稱</sys:String>
    <sys:String x:Key="Settings_Column_MachineType">機台類型</sys:String>
    <sys:String x:Key="Settings_Column_Ip">IP</sys:String>
    <sys:String x:Key="Settings_Column_Port">Port</sys:String>

    <sys:String x:Key="Settings_Column_RobotNo">機械手臂編號</sys:String>
    <sys:String x:Key="Settings_Column_RobotName">機械手臂名稱</sys:String>
    <sys:String x:Key="Settings_Column_RobotType">機械手臂型號</sys:String>

    <sys:String x:Key="Settings_Column_DeviceNo">裝置編號</sys:String>
