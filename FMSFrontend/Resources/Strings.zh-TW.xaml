    <sys:String x:Key="Settings_Section_Worker">工作人員</sys:String>
    <sys:String x:Key="Settings_Section_WorkerHint">系統的工作人員設定</sys:String>
    <sys:String x:Key="Settings_Tooltip_Add">新增</sys:String>
    <sys:String x:Key="Settings_Tooltip_Remove">刪除</sys:String>
    <sys:String x:Key="Settings_Column_WorkerNo">工號</sys:String>
    <sys:String x:Key="Settings_Column_WorkerName">使用者</sys:String>

    <sys:String x:Key="Settings_Group_Lubrication">潤滑排程</sys:String>
    <sys:String x:Key="Settings_Label_LubricationPeriod">潤滑週期</sys:String>
    <sys:String x:Key="Settings_Button_SetPeriod">設定週期</sys:String>
    <sys:String x:Key="Settings_Button_ForceLubrication">強制潤滑</sys:String>

    <sys:String x:Key="Settings_Text_DoNotClose">請勿關閉程式或中斷電源</sys:String>
</ResourceDictionary>
