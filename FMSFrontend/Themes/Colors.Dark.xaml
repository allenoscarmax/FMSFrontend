<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base / Background Colors -->
    <Color x:Key="BaseBackgroundColor">#ebebe1</Color>
    <Color x:Key="PanelBackgroundColor">#343434</Color>
    <Color x:Key="ControlBackgroundColor">#D5D5D5BF</Color>
    

    <!-- 對應 PrimaryBackgroundBrush = BaseBackgroundColor -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource BaseBackgroundColor}" />

    <!-- 對應 SidebarBackgroundBrush = PanelBackgroundColor -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />

    <!-- 對應 ControlPanelBackgroundBrush = ControlBackgroundColor -->
    <SolidColorBrush x:Key="ControlPanelBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />

    <!-- Title -->
    <Color x:Key="TitleColor">#005E93</Color>
    <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TitleColor}" />

    <!-- Status Panel / Menu Bar -->
    <Color x:Key="StatusPanelColor">#DBB037</Color>
    <Color x:Key="PageMenuBarColor">#005E93</Color>
    <SolidColorBrush x:Key="StatusPanelBrush" Color="{StaticResource StatusPanelColor}" />
    <SolidColorBrush x:Key="PageMenuBarBrush" Color="{StaticResource PageMenuBarColor}" />

    <!-- PageView -->
    <Color x:Key="PageViewColor">#030C20</Color>
    <SolidColorBrush x:Key="PageViewBrush" Color="{StaticResource PageViewColor}" />

    <!-- Font Colors -->
    <Color x:Key="PrimaryTextColor">White</Color>
    <Color x:Key="SecondaryTextColor">#D0D0D0</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />

    <!-- Button Backgrounds -->
    <Color x:Key="ButtonBackgroundColor">#2A2A2A</Color>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />

    <!-- Navigation Bar / Bottom bar -->
    <Color x:Key="DeepBlueColor">#2779A7</Color>
    <SolidColorBrush x:Key="DeepBlueBrush" Color="{StaticResource DeepBlueColor}" />

    <!-- Style: DarkModeTextBlock -->
    <Style x:Key="DarkModeTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>

    <!-- Style: DarkModeButton -->
    <Style x:Key="DarkModeButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="4" />
    </Style>
</ResourceDictionary>