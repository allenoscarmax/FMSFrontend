<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 自訂 GroupBox 樣式 -->
    <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="6" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- 標題區 -->
                                <RowDefinition Height="Auto" />
                                <!-- 內容區 -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 標題 -->
                            <Border Background="#555555" Padding="10,6" CornerRadius="6,6,0,0" BorderBrush="#555555" BorderThickness="0,0,0,1">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="FontSize" Value="20" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>

                            <!-- 單一內容區 -->
                            <ContentPresenter Grid.Row="1" Margin="16" Content="{TemplateBinding Content}" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>