<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 右上角鎖定膠囊按鈕（ToggleButton） -->
    <Style x:Key="LockPillButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="#F4F4F4" />
        <Setter Property="BorderBrush" Value="#CFCFCF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!-- 外框（底色/邊框可動畫） -->
                        <Border x:Name="bd" CornerRadius="16" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BgBrush" Color="#F4F4F4" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdrBrush" Color="#CFCFCF" />
                            </Border.BorderBrush>
                        </Border>

                        <!-- Hover 覆蓋層 -->
                        <Border x:Name="HoverOverlay" CornerRadius="16" Background="#FFFFFFFF" Opacity="0" IsHitTestVisible="False" />

                        <!-- 內容：改用 Margin 取代 Spacing，並把可動畫的前景刷放到 TextBlock -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 圖示：放置可動畫 Brush -->
                            <TextBlock x:Name="Icon" Text="🔒" FontSize="14" Margin="0,0,6,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="FgBrush" Color="#222222" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <!-- 文字共用同一把 Foreground Brush -->
                            <TextBlock x:Name="Text" Text="鎖定" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ElementName=Icon, Path=Foreground}" />
                        </StackPanel>

                        <!-- 視覺狀態與動畫 -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.05" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="CheckStates">
                                <!-- 鎖定 -->
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#F4F4F4" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="BdrBrush" Storyboard.TargetProperty="Color" To="#CFCFCF" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#222222" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                                <!-- 解鎖 -->
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#E6F6EE" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="BdrBrush" Storyboard.TargetProperty="Color" To="#9ED9BE" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#0B7A45" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>

                    <!-- 圖示/文字切換 -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Icon" Property="Text" Value="🔓" />
                            <Setter TargetName="Text" Property="Text" Value="解鎖" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Icon" Property="Text" Value="🔒" />
                            <Setter TargetName="Text" Property="Text" Value="鎖定" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>