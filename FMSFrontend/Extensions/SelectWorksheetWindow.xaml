<Window x:Class="FMSFrontend.Extensions.SelectWorksheetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:conv="clr-namespace:FMSFrontend.Converters" Title="選擇工單" Width="480" Height="576" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <!-- 你現有的 Enter-only 轉換器 -->
        <conv:KeyDownEnterOnlyConverter x:Key="KeyDownEnterOnlyConverter" />
    </Window.Resources>

    <!-- 外框 + 陰影 -->
    <Border CornerRadius="10" Background="White" BorderBrush="#DDD" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>

        <!-- 四段式切版：標題 / 搜尋 / 清單 / Footer -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <!-- Title -->
                <RowDefinition Height="84" />
                <!-- Search -->
                <RowDefinition Height="*" />
                <!-- List -->
                <RowDefinition Height="88" />
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar（深灰；也可綁定 TitleBrush，這裡加 FallbackValue） -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0" Background="{Binding TitleBrush, FallbackValue=#555555}">
                <TextBlock Text="選擇工單" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0" />
            </Border>

            <!-- 搜尋列：左 ICON + 底線 TextBox（顯示提示文字「搜尋」） -->
            <Grid Grid.Row="1" Margin="32,24,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="Search" Width="28" Height="28" Foreground="#666" Margin="0,4,12,0" />

                <Border Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="#222" VerticalAlignment="Center">
                    <!-- 綁定 SearchText，UpdateSourceTrigger=PropertyChanged => 輸入即觸發 ViewModel 的 ItemsView.Refresh() -->
                    <TextBox BorderThickness="0" Padding="0,2,0,6" FontSize="16" Foreground="#222" materialDesign:HintAssist.Hint="搜尋" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
            </Grid>

            <!-- 清單容器：灰底 + 上方深灰標題條 + 下方清單 -->
            <Border Grid.Row="2" Margin="24,0,24,0" Background="#F4F4F4" CornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <!-- header bar -->
                        <RowDefinition Height="*" />
                        <!-- list -->
                    </Grid.RowDefinitions>

                    <!-- Header Bar -->
                    <Border Grid.Row="0" Background="#666" CornerRadius="10,10,0,0" Margin="24,16,24,0">
                        <TextBlock Text="工件名稱（工單編號）" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- List -->
                    <Border  Grid.Row="1" Margin="24,0,24,16" Background="#E7E7E7" CornerRadius="0,0,10,10">
                        <ListView ItemsSource="{Binding WorksheetItems}" SelectedItem="{Binding SelectedWorksheet}" BorderThickness="0" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Row" Background="Transparent" Padding="20,14" SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="#D8E6F8" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="#EEE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <!-- 單列樣式：字體大小改為 16 -->
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="14" FontWeight="SemiBold">
                                        <Run Text="{Binding PartName}" />
                                        <Run Text="  (" />
                                        <Run Text="{Binding WorkOrderNo}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Border>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,16">
                <Button Content="確認" Width="108" Height="40" Margin="16,0" Command="{Binding ConfirmCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButtonStyle}" Background="Gray" />
                <Button Content="取消" Width="108" Height="40" Margin="16,0" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButtonStyle}" Background="Gray" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
