<Window x:Class="FMSFrontend.Extensions.MaterialPairWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" mc:Ignorable="d" Title="{DynamicResource MaterialPairWindow_Title}" Width="880" Height="616" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="8" ShadowDepth="2" Color="Black" Opacity="0.25" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Border Background="White" CornerRadius="10" Effect="{StaticResource ShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="80" />
            </Grid.RowDefinitions>

            <!-- ✅ 標題列 -->
            <Border Background="#444" CornerRadius="10,10,0,0" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <materialDesign:PackIcon Kind="Database" Width="24" Height="24" Foreground="White" />
                        <TextBlock Text="{DynamicResource MaterialPairWindow_Title}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" />
                    </StackPanel>

                    <Button Content="✕" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="Close_Click" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ✅ 返回 + RFID狀態燈 + 右側按鈕 -->
            <Grid Grid.Row="1" Margin="20,16,20,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0" Width="36" Height="36" Background="#EEE" BorderBrush="#DDD" BorderThickness="1" Command="{Binding BackCommand}">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" />
                </Button>

                <!-- RFID Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding RfidBindmodel.ConnectedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource MaterialPairWindow_Label_RfidConnected}" FontSize="14" Margin="6,0,16,0" VerticalAlignment="Center" />
                    <Ellipse Width="12" Height="12" Fill="{Binding RfidBindmodel.TagBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource MaterialPairWindow_Label_RfidTag}" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Spacer Column (Grid.Column=2) -->

                <!-- Right-Reset buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource MaterialPairWindow_Button_Reconnect}" Width="Auto" Height="30" Margin="3" Style="{StaticResource PrimaryButtonStyle}" Background="#2779A7" Command="{Binding BalluffResetCommand}" />
                </StackPanel>
            </Grid>

            <!-- ✅ 主內容區：Electrode or Workpiece -->
            <Grid Grid.Row="2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="807*"/>
                    <ColumnDefinition Width="73*"/>
                </Grid.ColumnDefinitions>
                <!-- 電極區 -->
                <Grid Visibility="{Binding ShowElectrodeSection, Converter={StaticResource BoolToVisibilityConverter}}" Margin="20,10,20,0" Grid.ColumnSpan="2">
                    <StackPanel>

                        <!-- ✅ 區塊標題 -->
                        <Border Height="38" Background="#2779A7" CornerRadius="4" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource MaterialPairWindow_Section_Electrode}" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                        </Border>

                        <!-- ✅ 第一區塊：選擇工單與工件（含底線按鈕 + 標題 + 箭頭，平均分配） -->
                        <Grid Margin="0,10,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <!-- 箭頭 -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：選擇工單 -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource MaterialPairWindow_Label_SelectWorkOrder}" FontSize="16" HorizontalAlignment="Left" Margin="0,0,0,15" Padding="10,2" Background="#555555" Foreground="#CCCCCC" Width="Auto" TextAlignment="Center"/>
                                <Button Content="{Binding SelectedWorkOrderName, FallbackValue='請選擇工單'}" Width="375" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="4,2" Command="{Binding SelectWorkOrderCommand}" />
                            </StackPanel>

                            <!-- 中：箭頭 -->
                            <Viewbox Grid.Column="1" Width="32" Height="36" Margin="24,0" VerticalAlignment="Bottom">
                                <TextBlock Text="→" />
                            </Viewbox>

                            <!-- 右：選擇電極 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource MaterialPairWindow_Label_SelectElectrode}" FontSize="16" HorizontalAlignment="Left" Margin="0,0,0,15" Padding="10,2" Background="#555555" Foreground="#CCCCCC" Width="Auto" TextAlignment="Center" />
                                <Button IsEnabled="{Binding SelectEnable}" Content="{Binding SelectedElectrodeNameDisplay, FallbackValue='請選擇電極'}" Width="375" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="4,2" Command="{Binding SelectElectrodeCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- ✅ 第二區塊：使用壽命、狀態、標籤序號 -->
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 使用壽命 -->
                                <StackPanel Grid.Column="0" Margin="8,0">
                                    <TextBlock Text="{DynamicResource MaterialPairWindow_Label_Lifetime}" FontSize="16" FontWeight="Bold" />
                                    <TextBox x:Name="Lifetime"  IsReadOnly="True" Text="{Binding Lifetime, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    <!-- <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="0,0,32,0" /> -->
                                </StackPanel>

                                <!-- 狀態 -->
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{DynamicResource MaterialPairWindow_Label_Status}"  FontSize="16" FontWeight="Bold" />
                                    <TextBox x:Name="Status" IsReadOnly="True" Text="{Binding SelectStatus, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    <!--  <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="0,0,32,0" /> -->
                                </StackPanel>

                                <!-- 標籤序號 -->
                                <StackPanel Grid.Column="2" Margin="8,0">
                                    <TextBlock Text="{DynamicResource MaterialPairWindow_Label_TagSerial}" FontSize="16" FontWeight="Bold" />
                                    <TextBox x:Name="TagSerial" Text="{Binding RfidBindmodel.TagSerial, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    <!--   <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="0,0,32,0" /> -->
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ✅ 第三區塊：零件名稱、EDM加工程式、目標EDM -->
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左邊區塊 -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="{DynamicResource MaterialPairWindow_Label_PartName}" Width="120" FontSize="16" FontWeight="Bold" />
                                        <TextBox x:Name="WName" IsReadOnly="True" Text="{Binding SelectName, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="{DynamicResource MaterialPairWindow_Label_EdmProgram}" Width="120" FontSize="16" FontWeight="Bold" />
                                        <TextBox x:Name="WPgm" IsReadOnly="True" Text="{Binding SelectPgm, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource MaterialPairWindow_Label_TargetEdm}" Width="120" FontSize="16" FontWeight="Bold" />
                                        <TextBox x:Name="WPairEdm" IsReadOnly="True" Text="{Binding SelectPairEdm, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 右邊區塊（預留）-->
                                <StackPanel Grid.Column="1" Margin="40,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="" Width="80" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="" FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="" Width="80" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="" FontSize="16" />
                                    </StackPanel>
                                    <!-- 可再加入欄位 -->
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Grid>

                <!-- 工件區 -->
                <Grid Visibility="{Binding ShowWorkpieceSection, Converter={StaticResource BoolToVisibilityConverter}}" Margin="20,10,20,0" Grid.ColumnSpan="2">
                    <StackPanel>

                        <!-- ✅ 區塊標題 -->
                        <Border Height="38" Background="#E08E45" CornerRadius="4" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource MaterialPairWindow_Section_Workpiece}" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                        </Border>

                        <!-- ✅ 第一區塊：選擇工單與工件（含底線按鈕 + 標題 + 箭頭，平均分配） -->
                        <Grid Margin="0,10,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <!-- 箭頭 -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：選擇工單 -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource MaterialPairWindow_Label_SelectWorkOrder}" FontSize="16" HorizontalAlignment="Left" Margin="0,0,0,15" Background="#555555" Foreground="#CCCCCC" Width="Auto" Padding="10,2" TextAlignment="Center" />
                                <Button Content="{Binding SelectedWorkOrderName, FallbackValue='請選擇工單'}" Width="375" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="4,2" Command="{Binding SelectWorkOrderCommand}" />
                            </StackPanel>

                            <!-- 中：箭頭 -->
                            <Viewbox Grid.Column="1" Width="32" Height="36" Margin="24,0" VerticalAlignment="Bottom">
                                <TextBlock Text="→" />
                            </Viewbox>

                            <!-- 右：選擇工件 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource MaterialPairWindow_Label_SelectWorkpiece}" FontSize="16" HorizontalAlignment="Left" Margin="0,0,0,15" Background="#555555" Foreground="#CCCCCC" Width="Auto" Padding="10,2"  TextAlignment="Center" />
                                <Button IsEnabled="{Binding SelectEnable}" Content="{Binding SelectedWorkpieceNameDisplay, FallbackValue='請選擇工件'}" Width="375" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="4,2" Command="{Binding SelectWorkpieceCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- ✅ 第二區塊：狀態、標籤序號（無使用壽命） -->
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 狀態 -->
                                <StackPanel Grid.Column="0" Margin="8,0">
                                    <TextBlock Text="{DynamicResource MaterialPairWindow_Label_Status}" FontSize="16" FontWeight="Bold" />
                                    <TextBox x:Name="EStatus" IsReadOnly="True" Text="{Binding SelectStatus, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    <!-- <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="10,0,32,0" /> -->
                                </StackPanel>

                                <!-- 標籤序號 -->
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{DynamicResource MaterialPairWindow_Label_TagSerial}" FontSize="16" FontWeight="Bold" />
                                    <TextBox x:Name="ETagSerial" Text="{Binding RfidBindmodel.TagSerial, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    <!-- <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="10,0,32,0" /> -->
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ✅ 第三區塊：零件名稱、EDM加工程式、目標EDM -->
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左邊區塊 -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="{DynamicResource MaterialPairWindow_Label_PartName}" Width="120" FontSize="16" FontWeight="Bold" />
                                        <TextBox x:Name="EName" IsReadOnly="True" Text="{Binding SelectName, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="{DynamicResource MaterialPairWindow_Label_EdmProgram}" Width="120" FontSize="16" FontWeight="Bold" />
                                        <TextBox x:Name="EPgm" IsReadOnly="True"  Text="{Binding SelectPgm, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource MaterialPairWindow_Label_TargetEdm}" Width="120" FontSize="16" FontWeight="Bold" />
                                        <TextBox x:Name="EPairEdm" IsReadOnly="True" Text="{Binding SelectPairEdm, UpdateSourceTrigger=PropertyChanged}" Width="300" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Black" FontSize="16" Padding="2,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 右邊區塊（預留）-->
                                <StackPanel Grid.Column="1" Margin="40,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="" Width="80" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="" FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="" Width="80" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="" FontSize="16" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Grid>

            </Grid>

            <!-- ✅ PAIR 按鈕 -->
            <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="{DynamicResource MaterialPairWindow_Button_Pair}" Width="160" Height="42" Style="{StaticResource PrimaryButtonStyle}" Background="#2779A7" Command="{Binding PairCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
